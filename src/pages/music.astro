---
import "../styles/site/music.css";
import Base from "../layouts/Base.astro";
import MusicPage from "../components/pages/MusicPage.astro";
import { getEntry, render } from "astro:content";
import { optimizedSrc } from "../lib/responsive-image.ts";
const entry = await getEntry("pages", "music");
if (!entry) throw new Error("Missing music content");
const { Content } = await render(entry);
const page = entry.data;
const preloadImage = await optimizedSrc(
  "/wp-content/uploads/2025/04/mymusic-header.webp",
);
---

<Base
  title={page.title}
  description={page.description}
  pageUrl={page.path}
  preloadImage={preloadImage}
>
  <h1 class="screen-reader-text">{page.title}</h1>
  <MusicPage page={page}>
    <Content />
  </MusicPage>
</Base>
