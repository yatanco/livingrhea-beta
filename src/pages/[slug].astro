---
import Base from '../layouts/Base.astro';
import { getAllPages, getPageBySlug } from '../lib/wordpress.js';

export async function getStaticPaths() {
  const pages = await getAllPages();
  // Excludes: the front page (index.astro renders slug "livingrhea-com"),
  // contact (contact.astro handles the form), and WP's default sample page.
  // 'blog' is the WP posts-page (archive template, no standard content
  // wrapper) — blog/index.astro renders the listing instead.
  const EXCLUDE = ['home', 'livingrhea-com', 'contact', 'sample-page', 'blog'];
  return pages
    .filter((p) => !EXCLUDE.includes(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
---
<Base title={page.title.rendered} description={page.excerpt?.rendered} headCss={page.wpb_custom_css} pageUrl={page.link}>
  <h1 set:html={page.title.rendered} />
  <!--
    This renders WPBakery's output HTML as-is (it's just HTML/CSS
    classes once WPBakery has rendered it server-side — WPBakery's
    react/vc_row shortcodes are resolved by WP before the REST API
    ever returns content.rendered). Sliders, testimonial carousels,
    and the pricing/package grid on /coaching/ will show as static
    HTML, not interactive — rebuild those as real Astro components
    once you see which pages need it (coaching page's PACKAGES section
    is the main one). See MIGRATION-TODO.md #5.
  -->
  <div class="wp-content" set:html={page.content.rendered} />
</Base>
