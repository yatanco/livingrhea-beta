---
import Base from '../layouts/Base.astro';
import WpContent from '../components/WpContent.astro';
import { getAllPages, heroImage } from '../lib/wordpress.js';

export async function getStaticPaths() {
  const pages = await getAllPages();
  // Excludes: the front page (index.astro renders slug "livingrhea-com"),
  // contact (contact.astro handles the form), and WP's default sample page.
  // 'blog' is the WP posts-page (archive template, no standard content
  // wrapper) — blog/index.astro renders the listing instead.
  const EXCLUDE = ['home', 'livingrhea-com', 'contact', 'sample-page', 'blog'];
  return pages
    .filter((p) => !EXCLUDE.includes(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
---
<Base title={page.title.rendered} description={page.excerpt?.rendered} headCss={page.wpb_custom_css} pageUrl={page.link} preloadImage={heroImage(page)}>
  <h1 set:html={page.title.rendered} />
  {/* WPBakery output HTML (rendered server-side by WP). Sliders / testimonial
      carousels / the coaching PACKAGES grid render as static HTML — candidates
      to rebuild as Astro components later. See MIGRATION-TODO.md #5. */}
  <WpContent html={page.content.rendered} />
</Base>
