---
import Base from "../layouts/Base.astro";
import { getAllPages, render } from "../lib/content.js";
export async function getStaticPaths() {
  return (await getAllPages())
    .filter((p) => !["livingrhea-com", "contact"].includes(p.slug))
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---

<Base
  title={page.title}
  description={page.description || undefined}
  preloadImage={page.hero}
  ><section class:list={["page-heading", { "with-image": page.hero }]}>
    <div>
      <p class="eyebrow">Living Rhea</p><h1>{page.title}</h1>{
        page.description && <p class="intro">{page.description}</p>
      }
    </div>{
      page.hero && (
        <img src={page.hero} alt={page.heroAlt || ""} fetchpriority="high" />
      )
    }
  </section><article class="prose" set:html={render(page.body)} /><section
    class="closing"
  >
    <p class="eyebrow">Begin a conversation</p><h2>
      Your next chapter starts here.
    </h2><a class="button" href="/contact/">Connect with Rhea ↗</a>
  </section></Base
>
