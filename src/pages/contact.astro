---
import "../styles/site/contact.css";
import Base from "../layouts/Base.astro";
import ContactPage from "../components/pages/ContactPage.astro";
import { getEntry, render } from "astro:content";
const entry = await getEntry("pages", "contact");
if (!entry) throw new Error("Missing contact content");
const { Content } = await render(entry);
const page = entry.data;
---

<Base title={page.title} description={page.description} pageUrl={page.path}>
  <h1 class="screen-reader-text">{page.title}</h1>
  <ContactPage page={page}>
    <Content />
  </ContactPage>
</Base>
