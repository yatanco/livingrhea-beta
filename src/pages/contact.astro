---
import Base from '../layouts/Base.astro';
---
<Base title="Contact">
  <h1>Get in touch with Dr. Rhea</h1>

  <!--
    TODO (manual step, see MIGRATION-TODO.md #2):
    Using Formspree — sign up at formspree.io, create a form, swap in
    your real form ID below (formspree.io/f/XXXXXXXX). No backend code
    needed. Fields match the original WPForms form.
  -->
  <form name="contact" method="POST" action="https://formspree.io/f/YOUR_FORM_ID">
    <label>First name <input type="text" name="first_name" required /></label>
    <label>Last name <input type="text" name="last_name" required /></label>
    <label>Email <input type="email" name="email" required /></label>
    <label>Subject <input type="text" name="subject" /></label>
    <label>Message <textarea name="message" required></textarea></label>
    <button type="submit">Submit</button>
  </form>
</Base>
