---
import "../styles/site/smoothie-movement.css";
import Base from "../layouts/Base.astro";
import SmoothieMovementPage from "../components/pages/SmoothieMovementPage.astro";
import { getEntry, render } from "astro:content";
const entry = await getEntry("pages", "smoothie-movement");
if (!entry) throw new Error("Missing smoothie-movement content");
const { Content } = await render(entry);
const page = entry.data;
---

<Base
  title={page.title}
  description={page.description}
  pageUrl={page.path}
  preloadImage="/wp-content/uploads/2025/06/favorite-green-smoothie.webp"
>
  <h1>{page.title}</h1>
  <SmoothieMovementPage page={page}>
    <Content />
  </SmoothieMovementPage>
</Base>
