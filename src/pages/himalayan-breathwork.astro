---
import Base from "../layouts/Base.astro";
import HimalayanBreathworkPage from "../components/pages/HimalayanBreathworkPage.astro";
import { getEntry, render } from "astro:content";
import { optimizedSrc } from "../lib/responsive-image.ts";
const entry = await getEntry("pages", "himalayan-breathwork");
if (!entry) throw new Error("Missing himalayan-breathwork content");
const { Content } = await render(entry);
const page = entry.data;
const preloadImage = await optimizedSrc(
  "/wp-content/uploads/2025/08/IMG_7995.2-1.webp",
);
---

<Base
  title={page.title}
  description={page.description}
  socialImage={preloadImage}
  service="Breathwork"
>
  <HimalayanBreathworkPage page={page}>
    <Content />
  </HimalayanBreathworkPage>
</Base>
