---
import "../styles/site/himalayan-breathwork.css";
import Base from "../layouts/Base.astro";
import HimalayanBreathworkPage from "../components/pages/HimalayanBreathworkPage.astro";
import { getEntry, render } from "astro:content";
const entry = await getEntry("pages", "himalayan-breathwork");
if (!entry) throw new Error("Missing himalayan-breathwork content");
const { Content } = await render(entry);
const page = entry.data;
---

<Base
  title={page.title}
  description={page.description}
  pageUrl={page.path}
  preloadImage="/wp-content/uploads/2025/08/IMG_7995.2-1.webp"
>
  <h1 class="screen-reader-text">{page.title}</h1>
  <HimalayanBreathworkPage page={page}>
    <Content />
  </HimalayanBreathworkPage>
</Base>
