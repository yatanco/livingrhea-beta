---
import "../styles/site/press.css";
import Base from "../layouts/Base.astro";
import PressPage from "../components/pages/PressPage.astro";
import { getEntry, render } from "astro:content";
import { optimizedSrc } from "../lib/responsive-image.ts";
const entry = await getEntry("pages", "press");
if (!entry) throw new Error("Missing press content");
const { Content } = await render(entry);
const page = entry.data;
const preloadImage = await optimizedSrc(
  "/wp-content/uploads/2025/08/DSC09720-548-Header-scaled.webp",
);
---

<Base
  title={page.title}
  description={page.description}
  pageUrl={page.path}
  preloadImage={preloadImage}
>
  <h1 class="screen-reader-text">{page.title}</h1>
  <PressPage page={page}>
    <Content />
  </PressPage>
</Base>
