---
import Base from "../layouts/Base.astro";
import WpContent from "../components/WpContent.astro";
import { getPageBySlug, heroImage } from "../lib/content.js";

// Keep the original front-page slug; content is loaded from the local export.
const home = await getPageBySlug("livingrhea-com");
---

<Base
  title="Home"
  description="PhD toxicologist & holistic health coach helping women with fertility, detox & postpartum recovery."
  headCss={home?.wpb_custom_css}
  pageUrl={home?.link}
  preloadImage={heroImage(home)}
>
  {
    /* TODO: the Instagram feed grid (MIGRATION-TODO #3) and the testimonials
      slider (#5) are the two blocks worth rebuilding as real components. */
  }
  <WpContent html={home?.content?.rendered ?? ""} />
</Base>
