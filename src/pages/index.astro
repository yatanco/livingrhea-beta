---
import Base from "../layouts/Base.astro";
import HomePage from "../components/pages/HomePage.astro";
import { getEntry, render } from "astro:content";
const entry = await getEntry("pages", "home");
if (!entry) throw new Error("Missing home content");
const { Content } = await render(entry);
const page = entry.data;
---

<Base
  title={page.title}
  description={page.description}
  socialImage={page.hero?.socialImage || page.hero?.image.src}
  overlayHeader
>
  <HomePage page={page}>
    <Content />
  </HomePage>
</Base>
