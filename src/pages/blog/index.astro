---
import "../../styles/site/about.css";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { getAllPosts } from "../../lib/posts.js";

const posts = await getAllPosts();

// First validated category from the article frontmatter.
function category(post) {
  const term = post.categories[0];
  return term
    ? { name: term.name, slug: term.slug }
    : { name: "Blog", slug: "blog" };
}
const plain = (html = "") => html.replace(/<[^>]+>/g, "").trim();
---

<Base title="Blog">
  <h1 class="screen-reader-text">Blog</h1>
  {/* Reproduces Salient's masonry blog archive markup so the theme CSS/JS
      (masonry layout, meta-overlaid cards) styles it. Links point at the Astro
      routes; images use the optimized/localized featured image. */}
  <div class="full-width-content blog-fullwidth-wrap meta-overlaid">
    <div
      class="post-area col span_12 col_last masonry auto_meta_overlaid_spaced"
      data-ams="8px"
      data-remove-post-date="0"
      data-remove-post-author="0"
      data-remove-post-comment-number="0"
      data-remove-post-nectar-love="0"
    >
      <div class="posts-container">
        {posts.map((post) => {
          const cat = category(post);
          const imported = post.featuredImage;
          const img = post.legacyFeaturedImage || imported?.src;
          const source =
            imported && imported.width > 800 ? imported : undefined;
          const url = `/blog/${post.slug}/`;
          return (
            <article
              class={`masonry-blog-item post-${post.legacyId || post.slug} post type-post status-publish format-standard has-post-thumbnail category-${cat.slug}`}
            >
              <div class="inner-wrap animated">
                <div class="post-content">
                  <div class="content-inner">
                    <a class="entire-meta-link" href={url}>
                      <span class="screen-reader-text">{post.title}</span>
                    </a>
                    {img && (
                      <span class="post-featured-img">
                        {source ? (
                          <Image
                            class="wp-post-image"
                            src={source}
                            alt={post.title}
                            width={Math.min(800, source.width)}
                            widths={[400, 800]}
                            sizes="(max-width: 650px) 100vw, (max-width: 1000px) 50vw, 33vw"
                            format="webp"
                            quality={82}
                            loading="lazy"
                          />
                        ) : (
                          <img
                            class="wp-post-image"
                            src={img}
                            width={imported?.width}
                            height={imported?.height}
                            decoding="async"
                            alt={post.title}
                            loading="lazy"
                          />
                        )}
                      </span>
                    )}
                    <div class="article-content-wrap">
                      <span class="meta-category">
                        <a class={cat.slug} href={url}>
                          {cat.name}
                        </a>
                      </span>
                      <div class="post-header">
                        <h3 class="title">
                          <a href={url}>{post.title}</a>
                        </h3>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</Base>

<!-- Salient's masonry JS only initializes on true blog-archive pages, so we lay
     the cards out with a reliable CSS grid and reproduce the meta-overlaid look
     (image card + category/title overlaid at the bottom). -->
<style>
  .blog-fullwidth-wrap .post-area,
  .blog-fullwidth-wrap .posts-container {
    width: 100% !important;
  }
  .blog-fullwidth-wrap .posts-container {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 10px;
  }
  .blog-fullwidth-wrap .masonry-blog-item {
    position: static !important;
    float: none !important;
    left: auto !important;
    top: auto !important;
  }
  /* Force the nested wrappers to fill the card — Salient's meta-overlaid CSS
     otherwise offsets/narrows them, pushing the image off to one side. */
  .blog-fullwidth-wrap .masonry-blog-item,
  .blog-fullwidth-wrap .inner-wrap,
  .blog-fullwidth-wrap .post-content,
  .blog-fullwidth-wrap .content-inner,
  .blog-fullwidth-wrap .post-featured-img {
    position: relative;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    float: none !important;
    inset: auto !important;
  }
  .blog-fullwidth-wrap .post-featured-img {
    display: block !important;
    margin: 0 !important;
  }
  .blog-fullwidth-wrap .post-featured-img img {
    display: block;
    width: 100%;
    height: 340px;
    object-fit: cover;
    /* Salient hides lazy images with opacity:0 until its JS fades them in;
       we load them directly, so keep them visible. */
    opacity: 1 !important;
    visibility: visible !important;
  }
  .blog-fullwidth-wrap .inner-wrap,
  .blog-fullwidth-wrap .inner-wrap.animated {
    opacity: 1 !important;
    transform: none !important;
  }
  .blog-fullwidth-wrap .article-content-wrap {
    position: absolute !important;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 26px 24px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
    z-index: 5;
  }
  .blog-fullwidth-wrap .meta-category a,
  .blog-fullwidth-wrap .post-header .title a {
    color: #fff !important;
  }
  .blog-fullwidth-wrap .meta-category {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .blog-fullwidth-wrap .post-header .title {
    margin: 8px 0 0;
    font-size: 22px;
    line-height: 1.2;
  }
  .blog-fullwidth-wrap .entire-meta-link {
    position: absolute;
    inset: 0;
    z-index: 10;
  }
</style>
