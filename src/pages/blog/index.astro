---
import Base from "../../layouts/Base.astro";
import { getAllPosts } from "../../lib/content.js";
const posts = await getAllPosts();
---

<Base title="Journal"
  ><section class="article-heading">
    <p class="eyebrow">Notes on a conscious life</p><h1>The journal</h1><p
      class="intro"
    >
      Ideas, recipes, and reflections on nourishing your whole self.
    </p>
  </section><section class="post-grid">
    {
      posts.map((post) => (
        <a class="post-card" href={`/blog/${post.slug}/`}>
          {post.hero ? (
            <img src={post.hero} alt={post.heroAlt || ""} loading="lazy" />
          ) : (
            <div class="card-placeholder">
              living <em>rhea</em>
            </div>
          )}
          <time datetime={post.date}>
            {new Date(post.date).toLocaleDateString("en", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
          </time>
          <>
            <h2>{post.title}</h2>
            <span>Read the story ↗</span>
          </>
        </a>
      ))
    }
  </section></Base
>
