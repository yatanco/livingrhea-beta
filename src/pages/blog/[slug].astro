---
import "../../styles/site/about.css";
import "../../styles/site/article.css";
import ArticleRecommendations from "../../components/ArticleRecommendations.astro";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getAllPosts, category, readingTime } from "../../lib/posts.js";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const source = post.featuredImage;
const cat = category(post);
const date = post.pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
// A post added through the CMS may only have a plain uploaded image
// (legacyFeaturedImage) with no Astro-optimized source yet.
const plainImage = !source && post.legacyFeaturedImage;
const { Content } = await render(post.entry);
---

<Base
  title={post.title}
  description={post.description}
  socialImage={source?.src || post.legacyFeaturedImage}
  article={{
    datePublished: post.pubDate.toISOString().replace(".000Z", "Z"),
    dateModified: post.updatedDate?.toISOString().replace(".000Z", "Z"),
    authorName: post.author,
    recipe: post.recipe,
    recipeCategory: post.categories.map((item) => item.name),
  }}
>
  <header slot="article-header" class="article-hero">
    {source ? (
      <Image
        src={source}
        alt=""
        width={source.width}
        widths={[480, 800, 1200, 1600].filter((w) => w <= source.width)}
        sizes="100vw"
        format="webp"
        quality={80}
        priority
      />
    ) : (
      plainImage && <img src={plainImage} alt="" fetchpriority="high" />
    )}
    <div class="article-hero-content">
      <span class="article-category">{cat.name}</span>
      <h1>{post.title}</h1>
      <div class="article-meta">
        <span>By {post.author}</span>
        <time datetime={post.pubDate.toISOString()}>{date}</time>
        <span>{readingTime(post.entry.body)} min read</span>
      </div>
    </div>
  </header>
  <nav class="article-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> » <a href="/blog/">Blog</a> »{" "}
    <span aria-current="page">{post.title}</span>
  </nav>
  <article class="article-copy wp-content">
    <Content />
  </article>
  <ArticleRecommendations slot="article-footer" post={post} />
</Base>
