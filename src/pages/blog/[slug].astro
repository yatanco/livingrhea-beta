---
import "../../styles/site/about.css";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getAllPosts } from "../../lib/posts.js";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const source = post.featuredImage;
// A post added through the CMS may only have a plain uploaded image
// (legacyFeaturedImage) with no Astro-optimized source yet.
const plainImage = !source && post.legacyFeaturedImage;
const { Content } = await render(post.entry);
---

<Base
  title={post.title}
  description={post.description}
  socialImage={source?.src || post.legacyFeaturedImage}
  article={{
    datePublished: post.pubDate.toISOString().replace(".000Z", "Z"),
    dateModified: post.updatedDate?.toISOString().replace(".000Z", "Z"),
    authorName: post.author,
  }}
>
  <article>
    <h1>{post.title}</h1>
    {source && (
      <Image
        src={source}
        alt={post.featuredImageAlt}
        width={source.width}
        widths={[480, 800, 1200, source.width].filter((w) => w <= source.width)}
        sizes="90vw"
        format="webp"
        quality={80}
        priority
      />
    )}
    {plainImage && <img src={plainImage} alt={post.featuredImageAlt} loading="eager" />}
    <div class="wp-content article-copy">
      <Content />
    </div>
    {/* WP comments aren't carried over; wire up giscus/Disqus later if wanted. */}
  </article>
</Base>
