---
import Base from '../../layouts/Base.astro';
import WpContent from '../../components/WpContent.astro';
import { getAllPosts, featuredImage } from '../../lib/wordpress.js';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---
<Base title={post.title.rendered} description={post.excerpt?.rendered} headCss={post.wpb_custom_css} preloadImage={featuredImage(post)}>
  <article>
    <h1 set:html={post.title.rendered} />
    {featuredImage(post) && <img src={featuredImage(post)} alt="" />}
    <WpContent html={post.content.rendered} />
    {/* WP comments aren't carried over; wire up giscus/Disqus later if wanted. */}
  </article>
</Base>
