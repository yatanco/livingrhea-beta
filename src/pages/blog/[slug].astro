---
import Base from "../../layouts/Base.astro";
import { getAllPosts, render } from "../../lib/content.js";
export async function getStaticPaths() {
  return (await getAllPosts()).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
---

<Base
  title={post.title}
  description={post.description || undefined}
  preloadImage={post.hero}
  ><div class="article-heading">
    <a class="eyebrow" href="/blog/">← The journal</a><h1>{post.title}</h1><time
      datetime={post.date}
      >{
        new Date(post.date).toLocaleDateString("en", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }</time>
  </div>{
    post.hero && (
      <img class="article-image" src={post.hero} alt={post.heroAlt || ""} />
    )
  }<article class="prose" set:html={render(post.body)} /></Base
>
