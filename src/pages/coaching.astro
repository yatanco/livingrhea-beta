---
import Base from "../layouts/Base.astro";
import CoachingPage from "../components/pages/CoachingPage.astro";
import { getEntry, render } from "astro:content";
import { optimizedSrc } from "../lib/responsive-image.ts";
const entry = await getEntry("pages", "coaching");
if (!entry) throw new Error("Missing coaching content");
const { Content } = await render(entry);
const page = entry.data;
const preloadImage = await optimizedSrc(
  "/wp-content/uploads/2025/04/home-banner-2.webp",
);
---

<Base
  title={page.title}
  description={page.description}
  socialImage={preloadImage}
  service="Holistic health coaching"
>
  <CoachingPage page={page}>
    <Content />
  </CoachingPage>
</Base>
