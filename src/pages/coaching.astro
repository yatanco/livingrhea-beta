---
import "../styles/site/coaching.css";
import Base from "../layouts/Base.astro";
import CoachingPage from "../components/pages/CoachingPage.astro";
import { getEntry, render } from "astro:content";
const entry = await getEntry("pages", "coaching");
if (!entry) throw new Error("Missing coaching content");
const { Content } = await render(entry);
const page = entry.data;
---

<Base
  title={page.title}
  description={page.description}
  pageUrl={page.path}
  preloadImage="/wp-content/uploads/2025/04/home-banner-2.webp"
>
  <h1 class="screen-reader-text">{page.title}</h1>
  <CoachingPage page={page}>
    <Content />
  </CoachingPage>
</Base>
