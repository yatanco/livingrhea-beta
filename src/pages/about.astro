---
import Base from "../layouts/Base.astro";
import AboutPage from "../components/pages/AboutPage.astro";
import { getEntry, render } from "astro:content";
import { optimizedSrc } from "../lib/responsive-image.ts";
const entry = await getEntry("pages", "about");
if (!entry) throw new Error("Missing about content");
const { Content } = await render(entry);
const page = entry.data;
const preloadImage = await optimizedSrc(
  "/wp-content/uploads/2025/08/042_Rhea_35294.webp",
);
---

<Base
  title={page.title}
  description={page.description}
  socialImage={preloadImage}
>
  <AboutPage page={page}>
    <Content />
  </AboutPage>
</Base>
