a-bg-overlay=\"false\"><div class=\"inner-wrap row-bg-layer\" ><div class=\"row-bg viewport-desktop\"  style=\"\"></div></div></div><div class=\"row_col_wrap_12 col span_12 dark left\">\n\t<div  class=\"vc_col-sm-6 link wpb_column column_container vc_column_container col no-extra-padding el_spacing_50px inherit_tablet inherit_phone \"  data-padding-pos=\"all\" data-has-bg-color=\"false\" data-bg-color=\"\" data-bg-opacity=\"1\" data-animation=\"\" data-delay=\"0\" >\n\t\t<div class=\"vc_column-inner\" >\n\t\t\t<div class=\"wpb_wrapper\">\n\t\t\t\t\n<div class=\"wpb_text_column wpb_content_element  a: text-decoration: underline\" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3><strong>HEALTH COACHING</strong></h3>\n<p>&nbsp;</p>\n<p><strong>VOGUE INDIA</strong></p>\n<p><a href=\"https://www.vogue.in/content/the-best-time-to-have-dry-fruits-and-nuts-according-to-experts\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">The Best time to have dry fruits and nuts according to experts</span></a></p>\n<p><strong>INSTITUTE FOR INTEGRATIVE COACHING (IIN)</strong></p>\n<p><a href=\"https://www.integrativenutrition.com/blog/scientist-health-coach-dr-rhea-mehta-on-science-and-inspiration\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Scientist and Health Coach Dr. Rhea Mehta on Science and Inspiration</span></a></p>\n\t</div>\n</div>\n\n\n\n\n<div class=\"wpb_text_column wpb_content_element \" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3></h3>\n<h3></h3>\n<h3><b>ASTE WELLNESS</b></h3>\n<p>&nbsp;</p>\n<p><strong>THE KIT</strong></p>\n<p><a href=\"https://thekit.ca/living/health/longevity-tips-for-women/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Longevity Tips for Women</span></a></p>\n<p><strong>VITA MAGAZINE</strong></p>\n<p><a href=\"https://vitamagazine.com/2024/10/17/aste-wellness-transforming-skincare-with-ayurveda-science-win/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Aste Wellness transforming Skincare with Ayurveda science</span></a></p>\n<p><strong>BEAUTY NEWS NYC </strong></p>\n<p><a href=\"https://www.beautynewsnycofficial.com/beauty/beautyscopes/hygeia-quantum-leap-or-roots-run-deep/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">HYGEIA: Quantum Leap or Roots Run Deep?</span></a></p>\n<p><strong>CRUNCHY MAMABOX</strong></p>\n<p><a href=\"https://crunchymamabox.com/blogs/interviews-2/women-in-wellness-dr-rhea-mehta-and-romana-kassam-of-aste-wellness-on-the-five-lifestyle-tweaks-that-will-help-support-people-s-journey-towards-better-wellbeing?srsltid=AfmBOorwDK252F_5ekuvcN2NDZmsesFAK68RDAtfCblztI01wpjBVXT2\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Five Lifestyle Tweaks That Will Help Support People’s Journey Towards Better Wellbeing</span></a></p>\n\t</div>\n</div>\n\n\n\n\n<div class=\"wpb_text_column wpb_content_element \" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3><b>PODCASTS</b></h3>\n<p>&nbsp;</p>\n<p><strong>THE BRAVE TABLE</strong></p>\n<p><a href=\"https://www.youtube.com/watch?v=GIZslueb1No\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">How hidden poisons are wrecking your health with Rhea Mehta</span></a></p>\n<p><strong>MINDBODYGREEN PODCAST</strong></p>\n<p><a href=\"https://podcast24.dk/episoder/the-mindbodygreen-podcast/126-how-to-rid-your-home-of-toxins-with-rhea-mehta-phd-RbUK6l97IZ\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">How to rid your home of toxins with Dr. Rhea Mehta</span></a></p>\n<p><strong>15-MINUTE MATRIX WITH ANDREA NAKAYAMA</strong></p>\n<p><a href=\"https://www.fxnutrition.com/podcast/mapping-patient-data-ownership-with-dr-rhea-mehta-226\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Mapping patient data ownership with Dr. Rhea Mehta</span></a></p>\n<p><strong>THE TONIC</strong></p>\n<p><a href=\"https://podcasts.apple.com/ca/podcast/216-cleanse-and-renew-for-2022-sound-therapy/id1312980372?i=1000546654320\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Sound Therapy with Rhea</span></a></p>\n<p><strong>ENTREPRENOLOGY PODCAST</strong></p>\n<p><a href=\"https://entrepologypodcast.libsyn.com/006-integrity-and-self-love-with-dr-rhea-mehta\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Community, play and entrepreneurship with Dr. Rhea Mehta</span></a></p>\n\t</div>\n</div>\n\n\n\n\n\t\t\t</div> \n\t\t</div>\n\t</div> \n\n\t<div  class=\"vc_col-sm-6 wpb_column column_container vc_column_container col no-extra-padding el_spacing_50px inherit_tablet inherit_phone \"  data-padding-pos=\"all\" data-has-bg-color=\"false\" data-bg-color=\"\" data-bg-opacity=\"1\" data-animation=\"\" data-delay=\"0\" >\n\t\t<div class=\"vc_column-inner\" >\n\t\t\t<div class=\"wpb_wrapper\">\n\t\t\t\t\n<div class=\"wpb_text_column wpb_content_element \" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3><b>MANTRA ARTIST &amp; YOGI</b></h3>\n<p>&nbsp;</p>\n<p><strong>BUSINESS INSIDER</strong></p>\n<p><a href=\"https://www.businessinsider.com/how-to-make-rooms-in-your-home-better-with-sound-2021-11\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">How to make rooms in your home better with sound</span></a></p>\n<p><strong>GIRL TALK HQ</strong></p>\n<p><a href=\"https://www.girltalkhq.com/yogi-singer-rhea-mehta-on-a-mission-to-share-south-asian-mantra-magic-with-the-world/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Yogi-Singer Rhea Mehta on a mission to share south asian mantra magic with the world</span></a></p>\n\t</div>\n</div>\n\n\n\n\n<div class=\"wpb_text_column wpb_content_element \" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3><b>BOWHEAD HEALTH</b></h3>\n<p>&nbsp;</p>\n<p><strong>FORBES</strong></p>\n<p><a href=\"https://www.forbes.com/sites/annabelacton/2017/07/14/the-future-of-health-its-in-your-hands/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">The future of health it’s in your hands</span></a></p>\n<p><strong>DIGITIMES</strong></p>\n<p><a href=\"https://www.digitimes.com/news/a20241119PR204/ctot-healthcare-medical-data-software.html&amp;chid=9\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Bowhead Health: Leveraging AI for precision medicine and patient empowerment</span></a></p>\n\t</div>\n</div>\n\n\n\n\n<div class=\"wpb_text_column wpb_content_element \" >\n\t<div class=\"wpb_wrapper\">\n\t\t<h3><b>PODCASTS</b></h3>\n<p>&nbsp;</p>\n<p><strong>DISS DASH</strong></p>\n<p><a href=\"https://www.youtube.com/watch?v=XjmTQk65rlE\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Science &amp; Soul + Modern mantra music + decolonizing wellness</span></a></p>\n<p><strong>DNX PODCAST</strong></p>\n<p><a href=\"https://www.youtube.com/watch?v=i_cEkE-M7ig\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">How to hack the healthcare system with Dr. Rhea Mehta</span></a></p>\n<p><strong>20 MIN FITNESS PODCAST</strong></p>\n<p><a href=\"https://shapescale.com/blog/20-minute-fitness-podcast/why-dr-rhea-mehta-built-bowhead-health/\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">Why Dr Rhea Mehta built the encrypted wellness platform Bowhead Health</span></a></p>\n<p><strong>VEGETARIAN FOOD FEST </strong></p>\n<p><a href=\"https://www.youtube.com/watch?v=unWa3A6urZc&amp;t=173s\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">The Global Smoothie Day initiative with Rhea</span></a></p>\n<p><strong>INNER CHANGEMAKER PODCAST</strong></p>\n<p><a href=\"https://www.youtube.com/watch?v=GjCoZ357RsM\" target=\"_blank\" rel=\"noopener\"><span style=\"font-weight: 400;\">How to start a social movement</span></a></p>\n\t</div>\n</div>\n\n\n\n\n\t\t\t</div> \n\t\t</div>\n\t</div> \n</div></div>\n",
