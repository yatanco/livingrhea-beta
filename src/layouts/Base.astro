---
import Newsletter from "../components/Newsletter.astro";
import settings from "../content/settings/site.json";
import "../styles/site.css";
const { title, description = settings.description, preloadImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ["About", "/about/"],
  ["Health coaching", "/coaching/"],
  ["Breathwork", "/himalayan-breathwork/"],
  ["Music", "/music/"],
  ["Press", "/press/"],
  ["Journal", "/blog/"],
];
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{title} | Dr. Rhea Mehta</title><meta
      name="description"
      content={description}
    /><link rel="canonical" href={canonical} /><meta
      property="og:title"
      content={`${title} | Dr. Rhea Mehta`}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:type" content="website" />{
      preloadImage && (
        <meta property="og:image" content={new URL(preloadImage, Astro.site)} />
      )
    }<meta name="twitter:card" content="summary_large_image" /><link
      rel="alternate"
      type="application/rss+xml"
      title="Living Rhea Journal"
      href="/blog/rss.xml"
    />{
      preloadImage && <link rel="preload" as="image" href={preloadImage} />
    }</head
  ><body
    ><a href="#main" class="skip">Skip to content</a><div class="announcement">
      <a href="/#newsletter"
        >A little nourishment for your inbox — get the free smoothie guide ↗</a>
    </div><header>
      <a class="brand" href="/" aria-label="Living Rhea home"
        >living <em>rhea</em><span>SCIENCE · SPIRIT · WELLBEING</span></a
      ><button
        class="nav-toggle"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false">Menu</button
      ><nav
        id="primary-navigation"
        class="navigation"
        aria-label="Main navigation"
      >
        {
          nav.map(([label, url]) => (
            <a
              href={url}
              aria-current={Astro.url.pathname === url ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }<a class="button small" href="/contact/">Connect with Rhea ↗</a>
      </nav>
    </header><main id="main"><slot /></main><section
      id="newsletter"
      class="newsletter-section"
    >
      <div>
        <p class="eyebrow">A nourishing ritual</p><h2>
          A little more vitality.<br />A little more you.
        </h2><p>
          Recipes, reflections, and practical tools for a more connected life.
        </p>
      </div><Newsletter />
    </section><footer>
      <a class="brand" href="/">living <em>rhea</em></a><p>
        Science-backed. Soul-aligned.
      </p><div>
        <a href="/contact/">Contact</a><a href="/blog/">Journal</a><a
          href={settings.instagram}>Instagram ↗</a
        ><a href="/admin/">Content editor</a>
      </div><small
        >© {new Date().getFullYear()} Dr. Rhea Mehta. All rights reserved.</small>
    </footer></body>
</html>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const navigation = document.querySelector("#primary-navigation");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    navigation?.classList.toggle("is-open", open);
  });
</script>
