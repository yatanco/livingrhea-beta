---
import { getSiteLayout } from "../lib/site-layout.js";
import SiteChrome from "../components/SiteChrome.astro";
import { plainText, pageDescriptions } from "../lib/seo.js";

interface Props {
  title: string;
  description?: string;
  /**
   * Original page URL whose saved layout (header treatment, body classes, per-page CSS)
   * this page should adopt. Pages pass their own `link`; blog posts/archive
   * fall back to a standard interior page (About) since their WP template
   * uses a different content wrapper.
   */
  pageUrl?: string;
  /** Above-the-fold LCP image to preload (e.g. the hero background). */
  preloadImage?: string;
  socialImage?: string;
  article?: {
    datePublished: string;
    dateModified?: string;
    authorName?: string;
    recipe?: {
      category?: string;
      yield?: string;
      ingredients: string[];
      instructions: string[];
    };
    recipeCategory?: string[];
  };
}
const {
  title,
  description = "",
  pageUrl = "/about/",
  preloadImage,
  socialImage,
  article,
} = Astro.props;

// Salient theme shell (header, footer, mobile menu, body classes, CSS + JS
// stack) saved from the original page. Reproduces the chrome the REST
// content field doesn't include. See src/lib/salient-shell.js.
const layout = getSiteLayout(pageUrl);
if (article) {
  layout.bodyAttrs = {
    ...layout.bodyAttrs,
    class: `${layout.bodyAttrs.class} livingrhea-article`,
  };
}
const canonical = new URL(Astro.url.pathname, Astro.site);
const plainTitle = plainText(title);
const plainDescription = (
  plainText(description) ||
  pageDescriptions[Astro.url.pathname] ||
  ""
).slice(0, 170);
const siteUrl = new URL("/", Astro.site).href;
const personId = `${siteUrl}#rhea-mehta`;
const socialSource = socialImage || preloadImage;
const image = socialSource ? new URL(socialSource, Astro.site).href : undefined;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Dr. Rhea Mehta",
      url: new URL("about/", Astro.site).href,
      sameAs: ["https://www.instagram.com/rheamehtaphd/"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Living Rhea",
      publisher: { "@id": personId },
    },
    {
      "@type": article ? "BlogPosting" : "WebPage",
      "@id": `${canonical.href}#page`,
      url: canonical.href,
      name: plainTitle,
      headline: plainTitle,
      description: plainDescription,
      isPartOf: { "@id": `${siteUrl}#website` },
      ...(image ? { image } : {}),
      ...(article
        ? {
            datePublished: article.datePublished,
            dateModified: article.dateModified,
            author: article.authorName
              ? { "@type": "Person", name: article.authorName }
              : { "@id": personId },
          }
        : {}),
    },
    ...(article?.recipe
      ? [
          {
            "@type": "Recipe",
            "@id": `${canonical.href}#recipe`,
            name: plainTitle,
            description: plainDescription,
            url: canonical.href,
            mainEntityOfPage: canonical.href,
            isPartOf: { "@id": `${siteUrl}#website` },
            ...(image ? { image } : {}),
            author: article.authorName
              ? { "@type": "Person", name: article.authorName }
              : { "@id": personId },
            datePublished: article.datePublished,
            ...(article.dateModified
              ? { dateModified: article.dateModified }
              : {}),
            ...(article.recipe.category
              ? { recipeCategory: article.recipe.category }
              : {}),
            ...(article.recipe.yield
              ? { recipeYield: article.recipe.yield }
              : {}),
            ...(article.recipeCategory?.length
              ? { keywords: article.recipeCategory }
              : {}),
            recipeIngredient: article.recipe.ingredients,
            recipeInstructions: article.recipe.instructions.map((text) => ({
              "@type": "HowToStep",
              text,
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{plainTitle} | Rhea Mehta</title>
    {plainDescription && <meta name="description" content={plainDescription} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${plainTitle} | Rhea Mehta`} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog"
      href="/blog/rss.xml"
    />

    <!-- Preload the LCP image (Salient applies hero images as CSS backgrounds,
         which the browser won't discover early on its own). -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/wp-content/uploads/useanyfont/8780Ogg-Regular.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/vendor/gstatic/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2"
      crossorigin="anonymous"
    />
    <!-- The icomoon icon font (nav/social glyphs) is only discovered once the
         browser parses icomoon.css, deep in the stylesheet chain — measured
         500ms+ of avoidable critical-path latency. Preload it directly. -->
    <link
      rel="preload"
      as="font"
      type="font/woff"
      href="/fonts/salient/icomoon.woff"
      crossorigin="anonymous"
    />
    <!-- Open Sans preload tried and reverted: it lowered that font's
         discovery latency (570ms → fast) but measurably worsened CLS
         (0.083 → 0.438, confirmed via PageSpeed's layout-shift-culprits
         breakdown, pointing at body text reflowing as the font swaps in).
         Loading the font faster moved its swap-triggered reflow earlier in
         the page lifecycle — into the window Lighthouse's CLS metric
         actually counts, instead of before first paint where it didn't.
         Revisit only with proper fallback font-metric overrides
         (size-adjust/ascent-override/descent-override) so the swap doesn't
         reflow text at all; don't just re-add the preload. -->

    <!-- Salient/WPBakery CSS, fonts and head assets, saved from the original site. -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-192x192.png"
    />
    <link
      rel="apple-touch-icon"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-180x180.png"
    />
  </head>
  <body {...layout.bodyAttrs}>
    <SiteChrome layout={layout}>
      <slot name="article-header" slot="article-header" />
      <slot />
      <slot name="article-footer" slot="article-footer" />
    </SiteChrome>

    <!-- Full Salient/WPBakery/plugin JS stack, in the live load order, as real
         script tags so they execute (jQuery first, then Salient init, sliders,
         superfish dropdowns, WPBakery front, etc.). -->
    {layout.scripts.map((s) =>
      s.src ? (
        <script
          is:inline
          src={s.src}
          defer={s.defer}
          async={s.async}
          id={s.id}
        />
      ) : (
        <script is:inline id={s.id} type={s.type} set:html={s.code} />
      ),
    )}
  </body>
</html>
