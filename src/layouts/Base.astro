---
import { getSalientShell } from "../lib/salient-shell.js";
import { WP_ORIGIN } from "../lib/wp-url.js";
import { plainText, pageDescriptions } from "../lib/seo.js";

interface Props {
  title: string;
  description?: string;
  /**
   * Original page URL whose saved layout (header treatment, body classes, per-page CSS)
   * this page should adopt. Pages pass their own `link`; blog posts/archive
   * fall back to a standard interior page (About) since their WP template
   * uses a different content wrapper.
   */
  pageUrl?: string;
  /** Above-the-fold LCP image to preload (e.g. the hero background). */
  preloadImage?: string;
  socialImage?: string;
  article?: {
    datePublished: string;
    dateModified?: string;
    authorName?: string;
  };
}
const {
  title,
  description = "",
  pageUrl = `${WP_ORIGIN}/about/`,
  preloadImage,
  socialImage,
  article,
} = Astro.props;

// Salient theme shell (header, footer, mobile menu, body classes, CSS + JS
// stack) saved from the original page. Reproduces the chrome the REST
// content field doesn't include. See src/lib/salient-shell.js.
const shell = await getSalientShell(pageUrl);
const canonical = new URL(Astro.url.pathname, Astro.site);
const plainTitle = plainText(title);
const plainDescription =
  pageDescriptions[Astro.url.pathname] || plainText(description).slice(0, 170);
const siteUrl = new URL("/", Astro.site).href;
const personId = `${siteUrl}#rhea-mehta`;
const socialSource = socialImage || preloadImage;
const image = socialSource ? new URL(socialSource, Astro.site).href : undefined;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Dr. Rhea Mehta",
      url: new URL("about/", Astro.site).href,
      sameAs: ["https://www.instagram.com/rheamehtaphd/"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Living Rhea",
      publisher: { "@id": personId },
    },
    {
      "@type": article ? "BlogPosting" : "WebPage",
      "@id": `${canonical.href}#page`,
      url: canonical.href,
      name: plainTitle,
      headline: plainTitle,
      description: plainDescription,
      isPartOf: { "@id": `${siteUrl}#website` },
      ...(image ? { image } : {}),
      ...(article
        ? {
            datePublished: article.datePublished,
            dateModified: article.dateModified,
            author: article.authorName
              ? { "@type": "Person", name: article.authorName }
              : { "@id": personId },
          }
        : {}),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{plainTitle} | Rhea Mehta</title>
    {plainDescription && <meta name="description" content={plainDescription} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${plainTitle} | Rhea Mehta`} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog"
      href="/blog/rss.xml"
    />

    <!-- Preload the LCP image (Salient applies hero images as CSS backgrounds,
         which the browser won't discover early on its own). -->
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    <link rel="preload" as="font" type="font/woff2" href="/wp-content/uploads/useanyfont/8780Ogg-Regular.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/vendor/gstatic/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2" crossorigin="anonymous" />

    <!-- Salient/WPBakery CSS, fonts and head assets, saved from the original site. -->
    <Fragment set:html={shell.headHtml} />

  </head>
  <body {...shell.bodyAttrs}>
    <!-- Saved Salient chrome: skip link, off-canvas wraps, header, and the
         opening content wrappers (#ajax-content-wrap → .row). -->
    <Fragment set:html={shell.preContent} />

    <!-- Local page content sits inside Salient's .row, exactly where
         WordPress would render it. -->
    <slot />

    <!-- Closing content wrappers + live footer + mobile slide-out menu +
         closing #ajax-content-wrap/.ocm-effect-wrap. -->
    <Fragment set:html={shell.postContent} />

    <!-- Full Salient/WPBakery/plugin JS stack, in the live load order, as real
         script tags so they execute (jQuery first, then Salient init, sliders,
         superfish dropdowns, WPBakery front, etc.). -->
    {
      shell.scripts.map((s) =>
        s.src ? (
          <script
            is:inline
            src={s.src}
            defer={s.defer}
            async={s.async}
            id={s.id}
          />
        ) : (
          <script is:inline id={s.id} type={s.type} set:html={s.code} />
        ),
      )
    }
  </body>
</html>
