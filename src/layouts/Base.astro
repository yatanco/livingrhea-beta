---
import "../styles/beta/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { plainText, pageDescriptions, snippet } from "../lib/seo.js";
import social from "../content/settings/social.json";
// Fingerprinted by Vite, so they can be cached forever; same files as global.css.
import interFont from "../assets/fonts/inter-latin.woff2?url";
import oggFont from "../assets/fonts/ogg-regular.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Above-the-fold LCP image to preload (e.g. the hero background). */
  preloadImage?: string;
  /** Matching srcset/sizes so the preload picks the same candidate. */
  preloadSrcset?: string;
  preloadSizes?: string;
  socialImage?: string;
  article?: {
    datePublished: string;
    dateModified?: string;
    authorName?: string;
    recipe?: {
      category?: string;
      yield?: string;
      ingredients: string[];
      instructions: string[];
    };
    recipeCategory?: string[];
  };
}
const {
  title,
  description = "",
  preloadImage,
  preloadSrcset,
  preloadSizes,
  socialImage,
  article,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const plainTitle = plainText(title);
const plainDescription = snippet(
  plainText(description) || pageDescriptions[Astro.url.pathname] || "",
);
const siteUrl = new URL("/", Astro.site).href;
const personId = `${siteUrl}#rhea-mehta`;
const socialSource = socialImage || preloadImage;
const image = socialSource ? new URL(socialSource, Astro.site).href : undefined;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Dr. Rhea Mehta",
      url: new URL("about/", Astro.site).href,
      // The same profiles as the header's social icons.
      sameAs: Object.values(social).filter((url) => url.startsWith("https://")),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Living Rhea",
      publisher: { "@id": personId },
    },
    {
      "@type": article ? "BlogPosting" : "WebPage",
      "@id": `${canonical.href}#page`,
      url: canonical.href,
      name: plainTitle,
      headline: plainTitle,
      description: plainDescription,
      isPartOf: { "@id": `${siteUrl}#website` },
      ...(image ? { image } : {}),
      ...(article
        ? {
            datePublished: article.datePublished,
            dateModified: article.dateModified,
            ...(article.recipeCategory?.length
              ? { articleSection: article.recipeCategory }
              : {}),
            author: article.authorName
              ? { "@type": "Person", name: article.authorName }
              : { "@id": personId },
          }
        : {}),
    },
    ...(article?.recipe
      ? [
          {
            "@type": "Recipe",
            "@id": `${canonical.href}#recipe`,
            name: plainTitle,
            description: plainDescription,
            url: canonical.href,
            mainEntityOfPage: canonical.href,
            isPartOf: { "@id": `${siteUrl}#website` },
            ...(image ? { image } : {}),
            author: article.authorName
              ? { "@type": "Person", name: article.authorName }
              : { "@id": personId },
            datePublished: article.datePublished,
            ...(article.dateModified
              ? { dateModified: article.dateModified }
              : {}),
            ...(article.recipe.category
              ? { recipeCategory: article.recipe.category }
              : {}),
            ...(article.recipe.yield
              ? { recipeYield: article.recipe.yield }
              : {}),
            ...(article.recipeCategory?.length
              ? { keywords: article.recipeCategory }
              : {}),
            recipeIngredient: article.recipe.ingredients,
            recipeInstructions: article.recipe.instructions.map((text) => ({
              "@type": "HowToStep",
              text,
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plainTitle} | Rhea Mehta</title>
    {plainDescription && <meta name="description" content={plainDescription} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={`${plainTitle} | Rhea Mehta`} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Living Rhea" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
    <link rel="alternate" type="application/rss+xml" title="Blog" href="/blog/rss.xml" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          imagesrcset={preloadSrcset}
          imagesizes={preloadSizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={oggFont}
      crossorigin="anonymous"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-192x192.png"
    />
    <link
      rel="apple-touch-icon"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-180x180.png"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot name="article-header" />
      <slot />
      <slot name="article-footer" />
    </main>
    <SiteFooter />
  </body>
</html>
