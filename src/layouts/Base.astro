---
import "../styles/beta/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { plainText, pageDescriptions, snippet } from "../lib/seo.js";
import Schema, { type Article } from "../components/Schema.astro";
// Fingerprinted by Vite, so they can be cached forever; same files as global.css.
import interFont from "../assets/fonts/inter-latin.woff2?url";
import oggFont from "../assets/fonts/ogg-regular.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Above-the-fold LCP image to preload (e.g. the hero background). */
  preloadImage?: string;
  /** Matching srcset/sizes so the preload picks the same candidate. */
  preloadSrcset?: string;
  preloadSizes?: string;
  socialImage?: string;
  /** Header floats transparently over the first section (homepage). */
  overlayHeader?: boolean;
  article?: Article;
  /** Marks the page as offering a service (e.g. "Health coaching"). */
  service?: string;
}
const {
  title,
  description = "",
  preloadImage,
  preloadSrcset,
  preloadSizes,
  socialImage,
  overlayHeader = false,
  article,
  service,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const plainTitle = plainText(title);
// The homepage title already names her; other pages get the name appended.
const fullTitle =
  Astro.url.pathname === "/" ? plainTitle : `${plainTitle} | Rhea Mehta`;
const plainDescription = snippet(
  plainText(description) || pageDescriptions[Astro.url.pathname] || "",
);
const socialSource = socialImage || preloadImage;
const image = socialSource ? new URL(socialSource, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {plainDescription && <meta name="description" content={plainDescription} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={plainDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Living Rhea" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <Schema
      url={canonical.href}
      title={plainTitle}
      description={plainDescription}
      image={image}
      article={article}
      service={service}
    />
    <link rel="alternate" type="application/rss+xml" title="Blog" href="/blog/rss.xml" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          imagesrcset={preloadSrcset}
          imagesizes={preloadSizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interFont}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={oggFont}
      crossorigin="anonymous"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-192x192.png"
    />
    <link
      rel="apple-touch-icon"
      href="/wp-content/uploads/2025/04/cropped-LivingRheaLogo-180x180.png"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot name="article-header" />
      <slot />
      <slot name="article-footer" />
    </main>
    <SiteFooter />
  </body>
</html>
