---
import "../styles/site/about.css";
import "../styles/site/archive.css";
import Base from "../layouts/Base.astro";
import PostGrid from "./PostGrid.astro";
import { Image } from "astro:assets";
import banner from "../assets/images/2019/09/roman-purtov-Z5Phu-u_sac-unsplash.jpg";

// Category and tag archives at their original WordPress URLs, with the
// theme's archive header (label, title, optional description).
interface Props {
  label: "Category" | "Tag";
  term: { name: string; slug: string; posts: any[] };
  description?: string;
}
const { label, term, description } = Astro.props;
---

<Base
  title={term.name}
  description={`${term.name} articles by Dr. Rhea Mehta on Living Rhea.`}
>
  <header slot="article-header" class="archive-hero">
    <Image
      src={banner}
      alt=""
      widths={[480, 800, 1200, 1800]}
      sizes="100vw"
      format="webp"
      quality={75}
      priority
    />
    <div class="container">
      <span class="archive-label">{label}</span>
      <h1>{term.name}</h1>
      {description && <p>{description}</p>}
    </div>
  </header>
  <PostGrid posts={term.posts} />
</Base>
