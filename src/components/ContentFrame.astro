---
import { prepareMarkup } from "../lib/performance.js";
// The design is rendered by native Astro children, never an exported HTML record.
const prepared = await prepareMarkup(await Astro.slots.render("default"), {
  lazyBackgrounds: true,
});
---

<div class="wp-content" set:html={prepared} />
<script>
  const reveal = (node: HTMLElement) => {
    node.style.backgroundImage = node.dataset.perfBackground || "";
    delete node.dataset.perfBackground;
  };
  const backgrounds = document.querySelectorAll<HTMLElement>(
    "[data-perf-background]",
  );
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            reveal(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
      },
      { rootMargin: "400px 0px" },
    );
    backgrounds.forEach((node) => observer.observe(node));
  } else backgrounds.forEach(reveal);
</script>
