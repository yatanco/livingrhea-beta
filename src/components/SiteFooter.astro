---
import SocialLinks from "./SocialLinks.astro";
import NewsletterForm from "./NewsletterForm.astro";
import { optimizedSrc } from "../lib/responsive-image.ts";

const year = new Date().getFullYear();
const logo = await optimizedSrc(
  "/wp-content/uploads/2025/04/LivingRheaLogo.png",
  300,
);
const quickLinks = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/coaching/", label: "Health Coaching" },
  { href: "/himalayan-breathwork/", label: "Himalayan Breathwork" },
  { href: "/smoothie-movement/", label: "Smoothie Movement" },
  { href: "/music/", label: "Music" },
  { href: "/press/", label: "Press" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <a href="/" aria-label="Living Rhea home">
        <img src={logo} alt="" width="150" height="31" loading="lazy" />
      </a>
      <p>
        Dr. Rhea Mehta blends nutrition science, holistic health coaching,
        breathwork, and ancestral wisdom.
      </p>
      <SocialLinks />
    </div>
    <nav aria-label="Footer">
      <h2>Quick links</h2>
      <ul>
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <h2>Get your free smoothie guide + health tips</h2>
      <p>
        A practical guide to nourishing your body through the healing power of
        smoothies, plus occasional health tips and product recommendations —
        straight to your inbox.
      </p>
      <NewsletterForm id="footer-email" label="Get the guide" dark />
    </div>
  </div>
  <p class="wrap legal">Copyright © {year} Rhea Mehta. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    padding-top: clamp(48px, 7vw, 80px);
    background: var(--dark);
    color: #d6d6d6;
    font-size: 0.94rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1.3fr;
    gap: 48px;
    padding-bottom: 48px;
  }
  .brand img {
    width: 150px;
    margin-bottom: 18px;
  }
  h2 {
    color: #fff;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav li a {
    display: inline-block;
    padding: 5px 0;
  }
  a {
    color: #e6e6e6;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-bright);
  }
  .legal {
    margin-block: 0;
    padding-block: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: #bdbdbd;
    font-size: 0.82rem;
    text-align: center;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
