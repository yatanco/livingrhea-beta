---
import { getAllPosts, termsWithPosts } from "../lib/posts.js";

// Links between the blog and its category archives, largest first.
interface Props {
  current?: string;
}
const { current } = Astro.props;
const categories = termsWithPosts(await getAllPosts()).sort(
  (a, b) => b.posts.length - a.posts.length,
);
---

<nav class="category-nav" aria-label="Blog categories">
  <a href="/blog/" aria-current={current ? undefined : "page"}>All</a>
  {categories.map((term) => (
    <a
      href={`/category/${term.slug}/`}
      aria-current={term.slug === current ? "page" : undefined}
    >
      {term.name}
    </a>
  ))}
</nav>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 44px);
    font-size: 0.92rem;
    line-height: 1.2;
  }
  .category-nav a {
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 9px 16px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .category-nav a:hover,
  .category-nav a[aria-current="page"] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
