---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

// Full-bleed photo with overlaid copy; the photo is the page's LCP image.
// `underHeader` runs the photo up behind a transparent header (homepage).
interface Props {
  image: ImageMetadata;
  position?: string;
  tall?: boolean;
  underHeader?: boolean;
}
const { image, position = "center", tall = false, underHeader = false } = Astro.props;
---

<section class:list={["hero", { tall, "under-header": underHeader }]}>
  <Picture
    src={image}
    formats={["avif", "webp"]}
    widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
    sizes="100vw"
    alt=""
    quality={55}
    loading="eager"
    fetchpriority="high"
    style={`object-position:${position}`}
  />
  <div class="wrap hero-copy">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(78vh, 720px);
    overflow: hidden;
    background: #333;
    color: #fff;
  }
  .hero.tall {
    min-height: min(88vh, 820px);
  }
  .hero :global(picture),
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.62), rgb(0 0 0 / 0.18) 70%);
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    padding-block: 72px;
  }
  .hero-copy :global(h1),
  .hero-copy :global(h2) {
    max-width: 16em;
    color: #fff;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
  }
  .hero-copy :global(p) {
    max-width: 34em;
    font-size: 1.15rem;
  }
  /* Photo starts behind the transparent header; copy clears it. */
  .hero.under-header {
    min-height: min(100svh, 900px);
  }
  .hero.under-header .hero-copy {
    padding-top: 180px;
  }
  .hero.under-header::after {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.45), transparent 240px),
      linear-gradient(90deg, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.12) 65%);
  }
  @media (max-width: 999px) {
    .hero.under-header .hero-copy {
      padding-top: 150px;
    }
  }
  @media (max-width: 640px) {
    .hero::after {
      background: rgb(0 0 0 / 0.5);
    }
  }
</style>
