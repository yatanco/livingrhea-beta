---
import settings from "../content/settings/site.json";
---

<form
  action={settings.newsletterAction}
  method="post"
  target="_blank"
  class="newsletter-form"
>
  <label for="newsletter-email">Your email address</label><div class="signup">
    <input
      id="newsletter-email"
      type="email"
      name="EMAIL"
      autocomplete="email"
      placeholder="you@example.com"
      required
    /><button type="submit">Send me the guide ↗</button>
  </div><div class="honeypot" aria-hidden="true">
    <label
      >Leave this empty<input
        type="text"
        name={settings.newsletterHoneypot}
        tabindex="-1"
        autocomplete="off"
      /></label>
  </div><small
    >Subscribe for the free guide and occasional updates. Unsubscribe anytime.
    Opens Mailchimp in a new tab.</small>
</form>
