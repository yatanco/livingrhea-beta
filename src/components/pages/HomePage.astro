const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const [mbg, vogueIndia, forbes, businessInsider, theSpruce, huffPost] =
  await Promise.all(
    [
      "/wp-content/uploads/2025/08/mbg.webp",
      "/wp-content/uploads/2025/08/vogue-india.webp",
      "/wp-content/uploads/2025/08/forbes.webp",
      "/wp-content/uploads/2025/08/Business-Insider-Logo.webp",
      "/wp-content/uploads/2025/08/thespruce.webp",
      "/wp-content/uploads/2025/08/The-Huffington-Post.webp",
    ].map((p) => optimizedSrc(p)),
  );
const instaPost = await responsiveImage(
  "/wp-content/uploads/2025/06/insta_post_48421.webp",
  [100, 140, 150, 300, 350, 500, 768, 800, 1000, 1080],
);
const favoriteSmoothie = await responsiveImage(
  "/wp-content/uploads/2025/06/favorite-green-smoothie.webp",
  [300, 768, 900, 1024, 1500],
);
const gsd5 = await responsiveImage(
  "/wp-content/uploads/2025/06/gsd-5.webp",
  [100, 140, 150, 300, 350, 500, 768, 800, 1000],
);
const [rheaBioCover, jeffWarrenBio, storyBg, rhea10Bg] = await Promise.all(
  [
    "/wp-content/uploads/2025/08/RheaBioCover.webp",
    "/wp-content/uploads/2025/08/jeff-warren_bio1-crop-300x300.webp",
    "/wp-content/uploads/2025/08/story.webp",
    "/wp-content/uploads/2025/08/RHEA_10-scaled.webp",
