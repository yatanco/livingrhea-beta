---
import { Image } from "astro:assets";
import Hero from "../Hero.astro";
import Pic from "../Pic.astro";
import Testimonials from "../Testimonials.astro";
import NewsletterForm from "../NewsletterForm.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const hero = page.hero;
const press = [
  ["mbg.webp", "mindbodygreen"],
  ["vogue-india.webp", "Vogue India"],
  ["forbes.webp", "Forbes"],
  ["Business-Insider-Logo.webp", "Business Insider"],
  ["thespruce.webp", "The Spruce"],
  ["The-Huffington-Post.webp", "The Huffington Post"],
].map(([file, name]) => ({ image: localImage(`/wp-content/uploads/2025/08/${file}`), name }));
const jeff = localImage("/wp-content/uploads/2025/08/jeff-warren_bio1-crop-300x300.webp");
const quotes = [
  ["the-biggest-impact-rhea-s-approach-had", "Hima-Batavia-10"],
  ["rhea-s-passion-is-infectious-her-intrepid", "Rahul-Sarugaser-11"],
  ["dr-rhea-is-unbelievably-informed-and-conveys", "Erin-Diedling-12"],
  ["rhea-offers-a-graceful-combination-of-practical", "Jess-R-13"],
  ["working-with-rhea-was-one-of-the", "Priya-Sankara-14"],
].map(([section, name]) => ({ html: copy[section], name: text[name] }));
// The "AS SEEN ON" heading arrives as Markdown; reuse its text.
const asSeenOn = copy["as-seen-on"].replace(/<[^>]+>/g, "").trim();
---

<Hero image={hero.image} position="70% 30%" tall>
  <h1>{hero.heading.join(" ")}</h1>
  <div class="actions">
    <a class="btn" href={hero.actionHref}>{hero.actionLabel}</a>
    <a class="btn light" href="#freeGuide">Free smoothie guide</a>
  </div>
</Hero>

<section class="wrap press" aria-labelledby="press-heading">
  <h2 id="press-heading" class="eyebrow center">{asSeenOn}</h2>
  <ul>
    {
      press.map(({ image, name }) => (
        <li>
          <Image src={image} alt={name} height={44} format="webp" quality={80} />
        </li>
      ))
    }
  </ul>
</section>

<section class="section wrap split" aria-labelledby="bio-heading">
  <Pic path="/wp-content/uploads/2025/08/RheaBioCover.webp" alt="Dr. Rhea Mehta" />
  <div>
    <h2 id="bio-heading" class="display">{text["DR-RHEA-MEHTA-1"]}</h2>
    <div class="prose" set:html={copy["is-a-scientist-healer-and-innovator-known"]} />
    <ul class="downloads">
      <li>
        <a class="arrow-link" href="https://www.dropbox.com/scl/fi/sslhm85dv4rfrdnuacm3g/DR.-RHEA-PhD-Speaker-kit.pdf?rlkey=yl34dqxgu6qm6icimhv100e19&dl=1">
          {text["Download-speaker-kit-2"]}
        </a>
      </li>
      <li>
        <a class="arrow-link" href="https://www.dropbox.com/scl/fi/tzeclqwgowkwa3wdwxwg1/Dr.Rhea_Aste-Wellness-Speaker-Kit.pdf?rlkey=dkcqzxsasqmemsbqr5maiucqg&dl=1">
          {text["Aste-Wellness-founder-speaker-kit-3"]}
        </a>
      </li>
    </ul>
    <figure class="mini-quote">
      <blockquote set:html={copy["there-is-something-a-little-bit-magical"]} />
      <figcaption>
        <Image src={jeff} alt="" width={48} height={48} format="webp" />
        <span><strong>{text["Jeff-Warren-4"]}</strong> {text["Author-and-Meditation-Teacher-5"]}</span>
      </figcaption>
    </figure>
  </div>
</section>

<section class="section tint" aria-labelledby="story-heading">
  <div class="wrap split flip">
    <Pic path="/wp-content/uploads/2025/08/story.webp" alt="Rhea with her child" />
    <div>
      <h2 id="story-heading" class="display">{text["MY-STORY-6"]}</h2>
      <div class="prose" set:html={copy["i-was-born-in-a-small-northern"]} />
      <a class="arrow-link" href="/coaching/">{text["Work-with-me-7"].trim()}</a>
    </div>
  </div>
</section>

<section class="section wrap split" aria-labelledby="approach-heading">
  <Pic path="/wp-content/uploads/2025/08/RHEA_10-scaled.webp" alt="Rhea holding a green smoothie" />
  <div>
    <h2 id="approach-heading" class="display">{text["RHEA-S-APPROACH-8"]}</h2>
    <div class="prose" set:html={copy["my-approach-blends-evidence-based-science-with"]} />
    <a class="btn" href="/coaching/">{text["BOOK-A-CONSULTATION-9"]}</a>
  </div>
</section>

<section class="section tint">
  <div class="wrap">
    <h2 class="display center">Kind words</h2>
    <Testimonials items={quotes} label="Client testimonials" />
  </div>
</section>

<section id="freeGuide" class="section wrap split guide" aria-labelledby="guide-heading">
  <div class="collage">
    <Pic path="/wp-content/uploads/2025/06/favorite-green-smoothie.webp" alt="A favourite green smoothie" sizes="(max-width: 860px) 100vw, 560px" widths={[400, 700, 1100]} />
    <Pic path="/wp-content/uploads/2025/06/insta_post_48421.webp" alt="" sizes="(max-width: 860px) 50vw, 280px" widths={[300, 560]} />
    <Pic path="/wp-content/uploads/2025/06/gsd-5.webp" alt="" sizes="(max-width: 860px) 50vw, 280px" widths={[300, 560]} />
  </div>
  <div>
    <span class="eyebrow">Free download</span>
    <h2 id="guide-heading" class="display">Smoothie starter guide</h2>
    <p>{text["Download-your-FREE-Smoothie-Starter-15"]}</p>
    <NewsletterForm id="guide-email" label={text["Get-the-guide-17"]} />
  </div>
</section>

<style>
  .press {
    padding-block: 48px 8px;
  }
  .press ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px clamp(28px, 5vw, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .press img {
    width: auto;
    height: 40px;
    filter: grayscale(1);
    opacity: 0.85;
  }
  .downloads {
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
  }
  .downloads li {
    padding: 6px 0;
  }
  .mini-quote {
    margin: 0;
    padding: 24px;
    background: var(--sand);
    border-radius: 6px;
    font-size: 0.95rem;
    font-style: italic;
  }
  .mini-quote blockquote {
    margin: 0 0 16px;
  }
  .mini-quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-style: normal;
    font-size: 0.88rem;
  }
  .mini-quote figcaption img {
    border-radius: 50%;
  }
  .mini-quote strong {
    display: block;
  }
  .collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .collage :global(img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .collage :global(img:not(:first-child)) {
    aspect-ratio: 1;
    object-fit: cover;
  }
  .guide {
    align-items: center;
  }
</style>
