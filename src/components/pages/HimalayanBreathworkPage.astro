---
import Hero from "../Hero.astro";
import Pic from "../Pic.astro";
import Video from "../Video.astro";
import Testimonials from "../Testimonials.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const t = (key: string) => text[key].trim();
const heroImage = localImage("/wp-content/uploads/2025/08/IMG_7995.2-1.webp");
const quotes = [
  ["rhea-s-guidance-is-deeply-meaningful-you", "Stephanie-Ngan-1"],
  ["rhea-s-breathwork-came-at-a-time", "SN-2"],
  ["attending-rhea-s-kriya-yoga-session-was", "Rachana-Bontra-3"],
  ["rhea-s-voice-was-beautiful-and-strong", "RB-4"],
  ["rhea-emits-vibrant-energy-in-her-sessions", "Himanshu-5"],
].map(([section, name]) => ({ html: copy[section], name: t(name) }));
---

<Hero image={heroImage}>
  <h1 class="display">{page.title}</h1>
  <blockquote class="hero-quote" set:html={copy["himalayan-breathwork-is-hands-down-some-of"]} />
  <a class="btn" href="/contact/">Book a session</a>
</Hero>

<section class="section wrap split" aria-label="Kriya breathwork and sound yoga">
  <div class="prose">
    <Fragment set:html={copy["kriya-breathwork-and-sound-yoga"].replace(/<(\/?)h3/g, "<$1h2")} />
    <Fragment set:html={copy["in-2019-i-traveled-to-rishikesh-india"]} />
  </div>
  <Pic
    path="/wp-content/uploads/2025/08/DSC09729-Additional-Batch-scaled.webp"
    alt="Dr. Rhea Mehta leading a breathwork session"
  />
</section>

<section class="section tint">
  <div class="wrap">
    <h2 class="display center">What participants say</h2>
    <Testimonials items={quotes} label="Participant testimonials" />
  </div>
</section>

<section class="section wrap" aria-labelledby="sessions-heading">
  <h2 id="sessions-heading" class="display center">{t("SNAPSHOT-OF-SESSIONS-WITH-RHEA-6")}</h2>
  <div class="videos">
    <Video id="AP0IRXcYdl8" title="Dr. Rhea Mehta Teaching Breath and Sound Yoga Session at Belong Festival in India" />
    <Video id="4ZtUdsEnbUY" title="Kriya and Mantra Yoga Class in Toronto led by Dr. Rhea Mehta" />
  </div>
</section>

<style>
  .hero-quote {
    max-width: 40em;
    margin: 0 0 28px;
    font-style: italic;
  }
  .hero-quote :global(p) {
    max-width: none;
  }
  .prose :global(h2) {
    margin-top: 0;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  }
  .videos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 760px) {
    .videos {
      grid-template-columns: 1fr;
    }
  }
</style>
