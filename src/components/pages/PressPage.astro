---
import Hero from "../Hero.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const heroImage = localImage("/wp-content/uploads/2025/08/DSC09720-548-Header-scaled.webp");
const plain = (html: string) => html.replace(/<[^>]+>/g, "").trim();
// Each feature is an outlet-name section followed by its article-link section.
const group = (label: string, sections: string[]) => ({
  title: text[label].trim(),
  items: Array.from({ length: sections.length / 2 }, (_, i) => ({
    outlet: plain(copy[sections[2 * i]]),
    link: copy[sections[2 * i + 1]].replace(/^<p>|<\/p>\s*$/g, ""),
  })),
});
const groups = [
  group("HEALTH-COACHING-1", [
    "vogue-india", "the-best-time-to-have-dry-fruits",
    "institute-for-integrative-coaching-iin", "scientist-and-health-coach-dr-rhea-mehta",
  ]),
  group("ASTE-WELLNESS-2", [
    "the-kit", "longevity-tips-for-women-https-thekit-ca",
    "vita-magazine", "aste-wellness-transforming-skincare-with-ayurveda-scienc",
    "beauty-news-nyc", "hygeia-quantum-leap-or-roots-run-deep",
    "crunchy-mamabox", "five-lifestyle-tweaks-that-will-help-support",
  ]),
  group("PODCASTS-3", [
    "the-brave-table", "how-hidden-poisons-are-wrecking-your-health",
    "mindbodygreen-podcast", "how-to-rid-your-home-of-toxins",
    "15-minute-matrix-with-andrea-nakayama", "mapping-patient-data-ownership-with-dr-rhea",
    "the-tonic", "sound-therapy-with-rhea-https-podcasts-apple",
    "entreprenology-podcast", "community-play-and-entrepreneurship-with-dr-rhea",
  ]),
  group("MANTRA-ARTIST-YOGI-4", [
    "business-insider", "how-to-make-rooms-in-your-home",
    "girl-talk-hq", "yogi-singer-rhea-mehta-on-a-mission",
  ]),
  group("BOWHEAD-HEALTH-5", [
    "forbes", "the-future-of-health-it-s-in",
    "digitimes", "bowhead-health-leveraging-ai-for-precision-medicine",
  ]),
  group("PODCASTS-3", [
    "diss-dash", "science-soul-modern-mantra-music-decolonizing-wellness",
    "dnx-podcast", "how-to-hack-the-healthcare-system-with",
    "20-min-fitness-podcast", "why-dr-rhea-mehta-built-the-encrypted",
    "vegetarian-food-fest", "the-global-smoothie-day-initiative-with-rhea",
    "inner-changemaker-podcast", "how-to-start-a-social-movement-https",
  ]),
];
---

<Hero image={heroImage} position="center 30%">
  <h1 class="display">{page.title}</h1>
  <div
    class="hero-quote"
    set:html={copy["dr-rhea-brings-to-the-arena-of"].replace(/<(\/?)h3[^>]*>/g, "<$1blockquote>")}
  />
</Hero>

<section class="section wrap" aria-label="Press features">
  <div class="groups">
    {
      groups.map((g) => (
        <section class="group">
          <h2 class="display">{g.title}</h2>
          <ul>
            {g.items.map((item) => (
              <li>
                <span class="eyebrow">{item.outlet}</span>
                <span class="link" set:html={item.link} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>

<style>
  .hero-quote {
    max-width: 40em;
    font-style: italic;
  }
  .hero-quote :global(blockquote) {
    margin: 0 0 16px;
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    line-height: 1.35;
  }
  .hero-quote :global(p) {
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .groups {
    columns: 3 300px;
    column-gap: clamp(28px, 4vw, 56px);
  }
  .group {
    break-inside: avoid;
    margin-bottom: 48px;
  }
  .group h2 {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 1.35rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin-bottom: 20px;
  }
  .eyebrow {
    margin-bottom: 4px;
  }
  .link :global(a) {
    color: var(--ink);
    font-weight: 500;
    text-decoration-color: var(--accent);
  }
  .link :global(a:hover) {
    color: var(--accent);
  }
</style>
