---
import Hero from "../Hero.astro";
import Pic from "../Pic.astro";
import Testimonials from "../Testimonials.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const t = (key: string) => text[key].trim();
const heroImage = localImage("/wp-content/uploads/2025/04/home-banner-2.webp");
const quotes = [
  ["you-are-directly-responsible-for-saving-my", "Adam-P-5"],
  ["i-am-fascinated-by-dr-rhea-s", "Dr-Neeta-Bhushan-6"],
  ["through-our-work-together-i-built-healthier", "AV-7"],
  ["after-working-with-rhea-i-felt-like", "Parul-Bansal-8"],
  ["i-was-coming-off-of-a-kidney", "Priya-9"],
  ["dr-rhea-brings-to-the-arena-of", "Dr-Sachin-Patel-10"],
].map(([section, name]) => ({ html: copy[section], name: t(name) }));
const included = [
  copy["six-1-1-coaching-sessions-60-min"],
  copy["health-history-review-metabolic-typing-assessment-we"],
  copy["your-clean-sweep-wellness-blueprint-a-fully"],
  `${copy["clean-sweep-resources-bundle"]}<ul>${[
    "Clean-Sweep-Meal-Plan-Recipes-21",
    "Shopping-List-for-Whole-Body-Reset-22",
    "Personalized-Supplement-Guide-23",
    "Ritual-Self-Care-Accessories-where--24",
  ]
    .map((key) => `<li>${t(key)}</li>`)
    .join("")}</ul>`,
  copy["symptom-habit-tracker-a-custom-tracking-system"],
  copy["session-notes-recap"] + copy["all-recommendations-shared-in-a-google-doc"],
  copy["unlimited-email-support-for-questions-check-ins"],
];
const framework = [
  ["Dream-28", "Paint-a-multi-sensory-picture-of-yo-29"],
  ["Design-30", "Optimize-your-schedule-to-support-y-31"],
  ["Clean-32", "Identify-and-discard-triggers-from--33"],
  ["Fuel-34", "Resolve-inefficiencies-in-body-and--35"],
].map(([title, body]) => ({ title: t(title), body: t(body) }));
---

<Hero image={heroImage}>
  <h1 class="display">Health coaching</h1>
  <blockquote class="hero-quote">
    <p>{t("The-program-that-Rhea-has-put-toget-1")}</p>
  </blockquote>
  <div class="actions">
    <a class="btn" href="/contact/">{t("BOOK-FREE-CONSULTATION-2")}</a>
    <a class="btn light" href="/contact/">{t("ORDER-YOUR-FULLSCRIPT-SUPPLEMENTS-3")}</a>
  </div>
</Hero>

<section class="section wrap split" aria-labelledby="upgrade-heading">
  <div>
    <h2 id="upgrade-heading">{t("Upgrade-your-health-and-environment-4")}</h2>
    <div class="prose" set:html={copy["as-human-beings-we-are-designed-to"]} />
  </div>
  <Pic path="/wp-content/uploads/2025/08/RHEA_7-1.webp" alt="Dr. Rhea Mehta holding a green smoothie" />
</section>

<section class="section tint">
  <div class="wrap">
    <h2 class="display center">Client stories</h2>
    <Testimonials items={quotes} label="Client testimonials" />
  </div>
</section>

<section class="section narrow" aria-labelledby="packages-heading">
  <h2 id="packages-heading" class="display center">{t("PACKAGES-11")}</h2>
  <div class="packages">
    <details>
      <summary>{t("BOOK-1-HOUR-PRIVATE-CONSULTATION-12")}</summary>
      <div class="prose" set:html={copy["one-on-one-consultation-with-dr-rhea"]} />
    </details>
    <details open>
      <summary>{t("CLEAN-SWEEP-3-MONTHS-13")}</summary>
      <div class="prose">
        <p>
          {text["This-14"]}<strong>{t("3-month-foundational-coaching-conta-15")}</strong>
          {text["is-designed-to-help-you-clean-sweep-16"]}<strong>{t("evidence-based-nutrition-functional-17")}</strong>{text["all-tailored-to-your-unique-needs-18"]}
        </p>
        <p>{t("This-is-for-you-if-you-re-ready-to--19")}</p>
        <h3>{t("What-s-Included-20")}</h3>
        <ul class="included">
          {included.map((html) => <li set:html={html} />)}
        </ul>
      </div>
    </details>
    <details>
      <summary>{t("MAINTENANCE-1x-MONTH-25")}</summary>
      <div class="prose"><p>{t("1-one-hour-coaching-session-per-mon-26")}</p></div>
    </details>
  </div>
  <p class="center">
    <a class="btn" href="/contact/">{t("BOOK-FREE-CONSULTATION-2")}</a>
  </p>
</section>

<section class="section tint" aria-labelledby="framework-heading">
  <div class="wrap">
    <h2 id="framework-heading" class="display center">{t("MY-COACHING-FRAMEWORK-27")}</h2>
    <div class="narrow center lead" set:html={copy["i-ve-broken-down-the-path-to"]} />
    <ol class="framework">
      {
        framework.map((step) => (
          <li>
            <h3 class="display">{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero-quote {
    max-width: 44em;
    margin: 0 0 28px;
    font-style: italic;
  }
  .hero-quote p {
    max-width: none;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
  }
  .packages {
    margin-bottom: 36px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font: 400 clamp(1.15rem, 2.2vw, 1.5rem) / 1.3 var(--serif);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font: 400 1.3rem/1 var(--sans);
  }
  details[open] summary::after {
    content: "−";
  }
  details .prose {
    padding-bottom: 24px;
  }
  .included {
    padding-left: 1.2em;
  }
  .included :global(p) {
    margin: 0;
  }
  .included li {
    margin-bottom: 0.9em;
  }
  .lead :global(p) {
    margin-inline: auto;
  }
  .framework {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .framework li {
    padding: 30px 26px;
    background: #fff;
    border-top: 3px solid var(--teal);
    border-radius: 6px;
    counter-increment: step;
  }
  .framework li::before {
    content: "0" counter(step);
    display: block;
    margin-bottom: 12px;
    color: var(--teal);
    font: 600 0.85rem/1 var(--sans);
    letter-spacing: 0.12em;
  }
  .framework p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .framework {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .framework {
      grid-template-columns: 1fr;
    }
  }
</style>
