---
import Pic from "../Pic.astro";
import Video from "../Video.astro";
import { pageSections } from "../../lib/page-sections.js";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const t = (key: string) => text[key].trim();
const research = [
  {
    href: "https://drive.google.com/file/d/106Q8XuNINoXPbrFdfaxn_I7us0lKU4PL/view?usp=sharing",
    title: t("Scientific-compendium-on-medicinal--5"),
    note: t("written-for-Vibe-Mushrooms-6"),
  },
  {
    href: "https://tspace.library.utoronto.ca/bitstream/1807/31865/6/Mehta_Rhea_201111_PhD_thesis.pdf",
    title: t("Doctoral-thesis-7"),
    note: t("on-investigating-the-cytoprotective-8"),
  },
  {
    href: "https://www.mindbodygreen.com/articles/5-activities-that-will-help-you-cleanse",
    title: t("5-activities-that-will-help-you-cle-9"),
  },
  {
    href: "https://www.mindbodygreen.com/articles/4-years-7-cleanses-3-lessons-a-toxicologist-explains",
    title: t("4-Years-7-Cleanses-3-Lessons-A-Toxi-10"),
  },
];
const talks = [
  {
    href: "https://www.youtube.com/watch?v=w7WLipkXmWQ",
    title: t("Blockchain-meets-healthcare-12"),
    note: t("at-HealthTO-Toronto-13"),
  },
  {
    href: "https://www.youtube.com/watch?v=injjrFugT9Y",
    title: t("My-formula-for-optimal-living-14"),
    note: t("at-Do-Lectures-Costa-Rica-15"),
  },
];
const videos = [
  ["aE5giax4dJc", "Toxic Truths with Dr. Rhea: Choose Canadian skincare over US skincare"],
  ["a84C6C0dNP8", "Toxic Truths with Dr. Rhea: Choose products that are personalized for women"],
  ["wNF3xfMNrew", "Toxic Truths with Dr. Rhea: Why drugstore skincare can accelerate aging"],
  ["rNdh0_flMvc", "Toxic Truths with Dr. Rhea: Over 350,000 chemicals registered for use globally"],
  ["z72AdMxv5mI", "Toxic Truths with Dr. Rhea: Chemicals in skincare that harm your hormones"],
  ["nTkAEl6akGc", "Toxic Truths with Dr. Rhea: Your skin absorbs 60% of what you put on it"],
];
---

<header class="wrap about-intro">
  <h1 class="display">{page.title}</h1>
  <blockquote>{t("Rhea-has-the-drive-of-an-entreprene-1")}</blockquote>
</header>

<section class="wrap split" aria-label="Biography">
  <Pic
    path="/wp-content/uploads/2025/08/042_Rhea_35294.webp"
    alt="Portrait of Dr. Rhea Mehta"
    eager
  />
  <div class="prose" set:html={copy["dr-rhea-mehta-is-a-scientist-wellness"]} />
</section>
<div class="wrap prose closing" set:html={copy["she-has-spoken-on-stages-across-the"]} />

<section class="section tint" aria-labelledby="story-heading">
  <div class="wrap split flip">
    <Pic
      path="/wp-content/uploads/2025/08/042_Rhea_35259.webp"
      alt="Dr. Rhea Mehta, eyes lowered in reflection"
    />
    <div>
      <h2 id="story-heading" class="display">{t("My-Story-2")}</h2>
      <div class="prose" set:html={copy["i-was-born-in-a-small-northern"]} />
    </div>
  </div>
  <div class="wrap prose closing" set:html={copy["these-moments-shaped-the-way-i-view"]} />
</section>

<section class="section wrap" aria-labelledby="work-heading">
  <h2 id="work-heading" class="display center">{t("FEATURED-PAST-WORK-3")}</h2>
  <div class="work">
    <div>
      <h3>{t("Scientific-research-articles-and-pu-4").replace(/:$/, "")}</h3>
      <ul>
        {
          research.map((item) => (
            <li>
              <a href={item.href}>{item.title}</a>
              {item.note && <span> {item.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>{t("Talks-11")}</h3>
      <ul>
        {
          talks.map((item) => (
            <li>
              <a href={item.href}>{item.title}</a>
              <span> {item.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section tint" aria-labelledby="videos-heading">
  <div class="wrap">
    <h2 id="videos-heading" class="display center">{t("Featured-Videos-16")}</h2>
    <div class="videos">
      {videos.map(([id, title]) => <Video id={id} title={title} />)}
    </div>
  </div>
</section>

<style>
  .about-intro {
    padding-block: clamp(44px, 7vw, 88px) clamp(32px, 4vw, 56px);
  }
  .about-intro blockquote {
    max-width: 52em;
    margin: 0;
    font: italic 400 clamp(1.15rem, 2vw, 1.5rem) / 1.55 var(--serif);
    color: #333;
  }
  .closing {
    padding-top: 32px;
  }
  .work {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 5vw, 72px);
  }
  .work ul {
    padding-left: 1.1em;
  }
  .work li {
    margin-bottom: 0.8em;
  }
  .work span {
    color: var(--muted);
  }
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 24px;
  }
  @media (max-width: 760px) {
    .work {
      grid-template-columns: 1fr;
    }
  }
</style>
