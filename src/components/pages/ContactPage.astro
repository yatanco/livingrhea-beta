---
import ContactForm from "../ContactForm.astro";
import SocialLinks from "../SocialLinks.astro";
const { page } = Astro.props;
const text = page.labels;
---

<section class="section wrap contact">
  <div>
    <span class="eyebrow">{page.title}</span>
    <h1>{text["Get-in-touch-with-Dr-Rhea-1"]}</h1>
    <p class="lead">
      Coaching, breathwork, speaking, or collaborations: send a note and Dr.
      Rhea will get back to you.
    </p>
    <SocialLinks class="contact-social" />
  </div>
  <ContactForm />
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .contact :global(.contact-social) {
    margin-left: -10px;
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
