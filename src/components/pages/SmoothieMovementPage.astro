---
import ContentFrame from "../ContentFrame.astro";
import { pageSections } from "../../lib/page-sections.js";
import {
  optimizedSrc,
  responsiveImage,
} from "../../lib/responsive-image.ts";
const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));

const favoriteSmoothieBg = await optimizedSrc(
  "/wp-content/uploads/2025/06/favorite-green-smoothie.webp",
);
const gsdSliderWidths = [100, 140, 150, 300, 350, 500, 768, 800, 1000];
const [gsd1, gsd2, gsd3, gsd4, gsd5] = await Promise.all(
  ["gsd-1", "gsd-2", "gsd-3", "gsd-4", "gsd-5"].map((name) =>
    responsiveImage(
      `/wp-content/uploads/2025/06/${name}.webp`,
      gsdSliderWidths,
    ),
  ),
);
const instaPost500 = await responsiveImage(
  "/wp-content/uploads/2025/06/insta_post_48421.webp",
  [100, 140, 150, 300, 350, 500, 768, 800, 1000, 1080],
);
const imgFeatured = await responsiveImage(
  "/wp-content/uploads/2025/06/img_featured_851481-500x500.webp",
  [100, 140, 150, 350, 500],
);
const [
  gsdGallery3,
  gsdGallery4,
  gsdGallery5,
  gsdGallery6,
] = await Promise.all(
  [
    "/wp-content/uploads/2025/06/gsd-gallery-3.webp",
    "/wp-content/uploads/2025/06/gsd-gallery-4.webp",
    "/wp-content/uploads/2025/06/gsd-gallery-5.webp",
    "/wp-content/uploads/2025/06/gsd-gallery-6-e1691422384549.webp",
  ].map((p) => optimizedSrc(p, 600)),
);
const countryWidths = [300, 768, 1000];
const [gsdCroatia, gsdKenya, gsdIndia, gsdUganda] = await Promise.all(
  ["gsd-croatia", "gsd-kenya", "gsd-india", "gsd-uganda"].map((name) =>
    responsiveImage(
      `/wp-content/uploads/2025/06/${name}.webp`,
      countryWidths,
    ),
  ),
);
const logoDummy = await responsiveImage(
  "/wp-content/uploads/2025/05/Logo-Dummy.webp",
  [300, 330],
);
const kaiPilger = await optimizedSrc(
  "/wp-content/uploads/2019/09/kai-pilger-mgFzfrrmGKI-unsplash.webp",
  2000,
);
const smoothieEbookBg = await optimizedSrc(
  "/wp-content/uploads/2025/06/Global-Smoothie-Day-E-Book_2020-1.webp",
);
