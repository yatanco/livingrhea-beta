---
import Hero from "../Hero.astro";
import Pic from "../Pic.astro";
import Video from "../Video.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const t = (key: string) => text[key].trim();
const heroImage = localImage("/wp-content/uploads/2025/06/favorite-green-smoothie.webp");
const ebook =
  "https://www.dropbox.com/scl/fi/kn8i7epl5ygsm07k2zipn/Global-Smoothie-Day-E-Book_2020.pdf?rlkey=f3bnfsbswi3rjvscxs7u40xty&e=1&dl=0";
const ebookAlt =
  "https://www.dropbox.com/scl/fi/kn8i7epl5ygsm07k2zipn/Global-Smoothie-Day-E-Book_2020.pdf?rlkey=f3bnfsbswi3rjvscxs7u40xty&e=2&dl=0";
const shareables = ["gsd-1", "gsd-2", "gsd-3", "gsd-4", "gsd-5"];
const gallery = ["gsd-gallery-3", "gsd-gallery-4", "gsd-gallery-5", "gsd-gallery-6-e1691422384549"];
const parties = [
  ["GSD-COMMUNITY-PARTY-CROATIA-22", "gsd-croatia", "/blog/gsd-community-party-croatia/"],
  ["GSD-COMMUNITY-PARTY-KENYA-23", "gsd-kenya", "/blog/gsd-community-party-kenya/"],
  ["GSD-COMMUNITY-PARTY-INDIA-24", "gsd-india"],
  ["GSD-COMMUNITY-PARTY-UGANDA-25", "gsd-uganda"],
].map(([label, image, href]) => ({ title: t(label), image, href }));
---

<Hero image={heroImage} tall>
  <h1 class="display">{t("October-3rd-is-1")} {t("GlobalSmoothieDay-2")}</h1>
  <p>{t("The-new-Green-Smoothies-are-good-fo-3")} {t("Join-us-in-Smoothie-Solidarity-4")}</p>
  <div class="actions">
    <a class="btn" href={ebook}>{t("Download-our-free-GSD-On-boarding-g-5")}</a>
    <a class="btn light" href="#highlights">{t("Q-A-on-The-Global-Smoothie-Day-7")}</a>
  </div>
</Hero>

<section class="section wrap mission" aria-label="Mission">
  <p>{t("The-GSD-mission-is-to-inspire-as-ma-8")}</p>
  <p>{t("Why-we-care-We-are-entering-a-globa-9")}</p>
</section>

<section class="section tint" aria-labelledby="cta-heading">
  <div class="wrap">
    <h2 id="cta-heading" class="display center">{t("CALL-TO-ACTION-10")}</h2>
    <p class="narrow center lead">{t("Inspire-your-online-community-by-sh-11")}</p>
    <ul class="shareables">
      {
        shareables.map((name, i) => (
          <li>
            <Pic
              path={`/wp-content/uploads/2025/06/${name}.webp`}
              alt={`Global Smoothie Day shareable graphic ${i + 1}`}
              sizes="(max-width: 700px) 45vw, 220px"
              widths={[300, 500]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="highlights" class="section wrap" aria-labelledby="highlights-heading">
  <p class="interview">
    <a href="https://www.mindbodygreen.com/articles/green-smoothie-recipe-that-incorporates-leftovers">
      {t("CLIMATE-FOCUSSED-INTERVIEW-WITH-MIN-12")} {t("GLOBAL-SMOOTHIE-DAY-13")} {t("FEATURING-LEFTOVERS-SMOOTHIE-14")}
    </a>
  </p>
  <h2 id="highlights-heading" class="center">
    {t("6-Years-of-Global-Smoothie-Day-15")} <em>{t("Highlights-16")}</em>
  </h2>
  <div class="highlights">
    <figure>
      <Video id="unWa3A6urZc" title="Q&A on The Global Smoothie Day Initiative (Dr. Rhea Mehta)" />
      <figcaption set:html={copy["vegetarian-food-festival-q-a-with-plant"]} />
    </figure>
    <figure>
      <Pic path="/wp-content/uploads/2025/06/insta_post_48421.webp" alt="Chef Charles Michel with Global Smoothie Day dishes" sizes="(max-width: 860px) 100vw, 33vw" widths={[400, 700]} />
      <figcaption set:html={copy["instagram-live-interview-with-chef-charles-michel"]} />
    </figure>
    <figure>
      <Pic path="/wp-content/uploads/2025/06/img_featured_851481-500x500.webp" alt="Leftovers green smoothies" sizes="(max-width: 860px) 100vw, 33vw" widths={[400]} />
      <figcaption set:html={copy["mindbodygreen-interview-with-global-smoothie-day-featuri"]} />
    </figure>
  </div>
</section>

<section class="section tint" aria-labelledby="parties-heading">
  <div class="wrap">
    <h2 id="parties-heading" class="display center">{t("GSD-COMMUNITY-PARTIES-17")}</h2>
    <ul class="gallery">
      {
        gallery.map((name) => (
          <li>
            <Pic path={`/wp-content/uploads/2025/06/${name}.webp`} alt="Global Smoothie Day community party" sizes="(max-width: 700px) 50vw, 25vw" widths={[300, 600]} />
          </li>
        ))
      }
    </ul>
    <ul class="parties">
      {
        parties.map((party) => (
          <li>
            <Pic path={`/wp-content/uploads/2025/06/${party.image}.webp`} alt="" sizes="(max-width: 700px) 100vw, 50vw" widths={[400, 700, 1000]} />
            <h3>{party.href ? <a href={party.href}>{party.title}</a> : party.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section wrap split support" aria-labelledby="support-heading">
  <div>
    <h2 id="support-heading">{t("BESIDES-CELEBRATING-WITH-US-ON-OCTO-26")}</h2>
    <ul class="checks">
      <li>{t("Making-smoothies-with-and-for-your--27")}</li>
      <li>{t("Visiting-the-smoothie-bars-who-are--28")}</li>
      <li>{t("Sharing-our-amazing-starter-kit-and-29")}</li>
    </ul>
    <a class="btn" href={ebookAlt}>{t("DOWNLOAD-OUR-FREE-GSD-ON-BOARDING-G-30")}</a>
  </div>
  <Pic path="/wp-content/uploads/2025/06/Global-Smoothie-Day-E-Book_2020-1.webp" alt="Global Smoothie Day starter kit and recipes e-book" />
</section>

<section class="quote-band">
  <Pic path="/wp-content/uploads/2019/09/kai-pilger-mgFzfrrmGKI-unsplash.webp" alt="" sizes="100vw" widths={[800, 1400, 2000]} quality={55} />
  <figure class="wrap">
    <blockquote set:html={copy["the-globalsmoothieday-mission-is-to-raise-awareness"]} />
    <figcaption>
      <strong>{t("DR-MARK-HYMAN-32")}</strong>
      {t("10X-NEW-YORK-TIMES-BEST-SELLING-AUT-33")}
    </figcaption>
  </figure>
</section>

<style>
  .mission {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .mission p {
    margin: 0;
    padding: 32px;
    border: 1px solid #9fd2c3;
    border-radius: 6px;
    font-size: 1.05rem;
  }
  .shareables {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .shareables :global(img) {
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 6px;
  }
  .interview {
    margin-bottom: 18px;
    text-align: center;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 36px;
  }
  .highlights figure {
    margin: 0;
  }
  .highlights :global(img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }
  figcaption {
    margin-top: 14px;
    font-size: 0.95rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }
  .gallery :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .parties :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }
  .parties h3 {
    margin-top: 16px;
    font-size: 1.3rem;
    text-transform: uppercase;
  }
  .parties a {
    color: var(--ink);
  }
  .support {
    align-items: center;
  }
  .support h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    text-transform: uppercase;
  }
  .checks {
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }
  .checks li {
    position: relative;
    margin-bottom: 12px;
    padding-left: 30px;
  }
  .checks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--teal);
    font-weight: 700;
  }
  .quote-band {
    position: relative;
    padding-block: clamp(80px, 12vw, 160px);
    overflow: hidden;
    color: #fff;
  }
  .quote-band > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .quote-band::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.55);
  }
  .quote-band figure {
    position: relative;
    z-index: 1;
    margin-block: 0;
  }
  .quote-band blockquote {
    max-width: 22em;
    margin: 0 0 20px;
    font: 400 clamp(1.6rem, 3.4vw, 2.6rem) / 1.25 var(--serif);
  }
  .quote-band :global(p) {
    margin: 0;
  }
  .quote-band strong {
    display: block;
  }
  @media (max-width: 860px) {
    .mission,
    .highlights,
    .parties {
      grid-template-columns: 1fr;
    }
    .shareables {
      grid-template-columns: repeat(3, 1fr);
    }
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
