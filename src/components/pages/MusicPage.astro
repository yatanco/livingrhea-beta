---
import Hero from "../Hero.astro";
import Pic from "../Pic.astro";
import Video from "../Video.astro";
import { pageSections } from "../../lib/page-sections.js";
import { localImage } from "../../lib/local-images.ts";

const { page } = Astro.props;
const text = page.labels;
const copy = pageSections(await Astro.slots.render("default"));
const t = (key: string) => text[key].trim();
const heroImage = localImage("/wp-content/uploads/2025/04/mymusic-header.webp");
// Sections run in page order; split them at the section that starts each block.
const keys = Object.keys(copy);
const between = (from: string, to?: string) =>
  keys
    .slice(keys.indexOf(from), to ? keys.indexOf(to) : undefined)
    .map((key) => copy[key])
    .join("");
const love = between(
  "rhea-s-love-for-indian-classical-music",
  "one-of-the-most-transformative-aspects-of",
);
const about = between(
  "one-of-the-most-transformative-aspects-of",
  "about-rhea-s-first-single-bright-light",
);
const single = between("about-rhea-s-first-single-bright-light");
---

<Hero image={heroImage}>
  <span class="eyebrow light">Debut EP</span>
  <h1 class="display">{t("Soul-Ceremony-1")}</h1>
  <p>{t("Soul-Ceremony-is-available-worldwid-3")}</p>
</Hero>

<section class="section wrap" aria-label="Music videos">
  <div class="videos">
    <Video id="Dn0C7QergUI" title="Free - Asatoma Mantra mix [Official Video]" />
    <Video id="1kz2XmpD3NM" title="Bright Light - Gayatri Mantra mix [Official Video]" />
  </div>
</section>

<section class="section tint" aria-labelledby="love-heading">
  <div class="wrap split">
    <div>
      <h2 id="love-heading">{t("Rhea-s-Love-for-Indian-Classical-Mu-2")}</h2>
      <div class="prose" set:html={love} />
    </div>
    <Pic path="/wp-content/uploads/2025/08/01B-Covers.webp" alt="Soul Ceremony EP cover art" />
  </div>
</section>

<section class="section narrow" aria-labelledby="about-heading">
  <h2 id="about-heading" class="display">{t("ABOUT-SOUL-CEREMONY-4").replace(/:$/, "")}</h2>
  <div class="prose" set:html={about} />
  <div class="promo">
    <Video id="dANZUcBKC_I" title="Soul Ceremony EP Promo" />
  </div>
  <div class="prose" set:html={single} />
</section>

<style>
  .eyebrow.light {
    color: #fff;
  }
  .videos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .promo {
    margin-block: 40px;
  }
  @media (max-width: 760px) {
    .videos {
      grid-template-columns: 1fr;
    }
  }
</style>
