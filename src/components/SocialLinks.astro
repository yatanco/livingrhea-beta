---
import social from "../content/settings/social.json";

// Inline SVG icons for the profiles in settings/social.json: no icon font.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const icons = {
  twitter: {
    label: "Rhea Mehta on X (Twitter)",
    svg: `<path d="M4 4h4.6l4.1 5.6L17.6 4H20l-6.2 7.1L20.6 20H16l-4.5-6.1L6.2 20H3.8l6.6-7.6z" />`,
  },
  facebook: {
    label: "Rhea Mehta on Facebook",
    svg: `<path d="M13.5 21v-7.4H16l.4-3h-2.9V8.8c0-.9.3-1.5 1.5-1.5h1.5V4.6c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.6V21z" />`,
  },
  youtube: {
    label: "Rhea Mehta on YouTube",
    svg: `<path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8M10 15V9l5.2 3z" />`,
  },
  rss: {
    label: "Subscribe to the blog RSS feed",
    svg: `<circle cx="6" cy="18" r="2" /><path d="M4 10.5v2.6a6.9 6.9 0 0 1 6.9 6.9h2.6A9.5 9.5 0 0 0 4 10.5m0-5.2v2.6A12.1 12.1 0 0 1 16.1 20h2.6A14.7 14.7 0 0 0 4 5.3" />`,
  },
  instagram: {
    label: "Rhea Mehta on Instagram",
    svg: `<path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4m0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6m6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0M7.8 3h8.4A4.8 4.8 0 0 1 21 7.8v8.4a4.8 4.8 0 0 1-4.8 4.8H7.8A4.8 4.8 0 0 1 3 16.2V7.8A4.8 4.8 0 0 1 7.8 3m0 1.7a3.1 3.1 0 0 0-3.1 3.1v8.4a3.1 3.1 0 0 0 3.1 3.1h8.4a3.1 3.1 0 0 0 3.1-3.1V7.8a3.1 3.1 0 0 0-3.1-3.1z" />`,
  },
  linkedin: {
    label: "Rhea Mehta on LinkedIn",
    svg: `<path d="M5 9h3v11H5zm1.5-5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5M10 9h2.9v1.5c.4-.8 1.4-1.7 3-1.7 3.1 0 3.6 2 3.6 4.7V20h-3v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20H10z" />`,
  },
} as const;
const links = (Object.keys(icons) as (keyof typeof icons)[])
  .filter((key) => social[key])
  .map((key) => ({ key, href: social[key], ...icons[key] }));
---

<ul class:list={["social", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          rel={link.key === "rss" ? undefined : "me noopener"}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.svg} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: inherit;
  }
  .social a:hover {
    color: var(--accent-bright);
  }
  .social svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
</style>
