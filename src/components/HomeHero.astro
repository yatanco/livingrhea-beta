---
import { Picture } from 'astro:assets';
import { localImage } from '../lib/local-images';
import '../styles/home-hero.css';
interface Props { image: string; content: string; }
const { image, content } = Astro.props;
const source = localImage(image);
if (!source) throw new Error(`Missing local hero image: ${image}`);
---
<section id="rhea-home-hero" class="rhea-hero loaded" data-full-width="false" data-fullscreen="false" data-button-sizing="large" data-button-styling="btn_with_count">
  <div class="rhea-hero-stage">
    <div class="rhea-hero-slide" data-color-scheme="light" data-x-pos="left" data-y-pos="middle">
      <div class="slide-bg-wrap">
        <Picture src={source} formats={['avif', 'webp']} widths={[480, 800, 1200, 1800]} sizes="100vw" alt="" loading="eager" fetchpriority="high" quality={50} class="rhea-hero-image" />
        <div class="slide-bg-overlay" aria-hidden="true"></div>
      </div>
      <div class="container"><div class="content" set:html={content} /></div>
    </div>
  </div>
</section>
