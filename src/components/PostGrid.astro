---
import { Image } from "astro:assets";
import { category } from "../lib/posts.js";

interface Props {
  posts: Awaited<ReturnType<typeof import("../lib/posts.js").getAllPosts>>;
  /** Cards above the fold load eagerly; the first is the likely LCP. */
  eager?: number;
  headingLevel?: "h2" | "h3";
}
const { posts, eager = 1, headingLevel: Heading = "h2" } = Astro.props;
// Small originals keep their own width rather than an empty srcset.
const cardWidths = (width: number) => {
  const fit = [360, 560, 760].filter((w) => w <= width);
  return fit.length ? fit : [width];
};
const date = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

<ul class="post-grid">
  {
    posts.map((post, index) => {
      const cat = category(post);
      const url = `/blog/${post.slug}/`;
      const loading = index < eager ? "eager" : "lazy";
      return (
        <li>
          <article class="card">
            <div class="media">
              {post.featuredImage ? (
                <Image
                  src={post.featuredImage}
                  alt=""
                  widths={cardWidths(post.featuredImage.width)}
                  sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 1000px) 45vw, 380px"
                  format="webp"
                  quality={62}
                  loading={loading}
                  fetchpriority={index === 0 ? "high" : undefined}
                />
              ) : (
                post.legacyFeaturedImage && (
                  <img
                    src={post.legacyFeaturedImage}
                    alt=""
                    width="600"
                    height="400"
                    loading={loading}
                  />
                )
              )}
            </div>
            <div class="body">
              <span class="eyebrow">{cat.name}</span>
              <Heading class="title">
                <a href={url}>{post.title}</a>
              </Heading>
              <time datetime={post.pubDate.toISOString()}>
                {date(post.pubDate)}
              </time>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(20px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Off-screen cards skip layout and paint until scrolled near. */
  li:nth-child(n + 7) {
    content-visibility: auto;
    contain-intrinsic-size: auto 440px;
  }
  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .card:hover {
    box-shadow: 0 14px 34px rgb(0 0 0 / 0.09);
    transform: translateY(-2px);
  }
  .media {
    aspect-ratio: 3 / 2;
    background: var(--sand);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 24px 24px;
  }
  .body .eyebrow {
    margin-bottom: 10px;
  }
  .title {
    margin: 0 0 14px;
    font-size: 1.32rem;
    line-height: 1.25;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole card is one link target. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover .title a {
    color: var(--accent);
  }
  time {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
