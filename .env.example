# Base URL of the WordPress install that stays running as the headless CMS.
# Must expose the default WP REST API (wp-json), which is on by default —
# no plugin required for pages/posts. If you add ACF fields later, add
# ACF to REST API (or WPGraphQL) and extend src/lib/wordpress.js.
WORDPRESS_API_URL=https://cms.livingrhea.com/wp-json/wp/v2
